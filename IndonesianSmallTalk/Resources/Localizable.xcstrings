    "실제 하루도 순서대로 오지 않아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real days don't come in order either."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día real tampoco llega en orden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari nyata pun tidak datang berurutan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の一日も順番どおりには来ません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现实中的一天也不是按顺序来的。"
          }
        }
      }
    },
    "실제로 듣고 본 외국어 한 줄을": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take one real line of a foreign language you heard or saw"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase en otro idioma que oíste o viste de verdad"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu kalimat bahasa asing yang benar-benar Anda dengar dan lihat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際に聞いたり見たりした外国語の一文を"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把亲耳听到、亲眼看到的一句外语"
          }
        }
      }
    },
