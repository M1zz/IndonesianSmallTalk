    "곧 가 볼 곳, 궁금한 상황부터 고르세요. 관심 있는 대화일수록 잘 안 잊힙니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte si místo, kam brzy pojedete, nebo situaci, která vás zajímá. Konverzace, na kterých vám záleží, vám v paměti zůstanou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg et sted, du snart skal hen, eller en situation, du er nysgerrig på. Samtaler, du interesserer dig for, sætter sig bedre fast."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Such dir einen Ort aus, den du bald besuchst, oder eine Situation, die dich neugierig macht. Gespräche, die dich interessieren, bleiben besser hängen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε κάπου που θα πας σύντομα ή μια κατάσταση που σε ενδιαφέρει. Οι συζητήσεις που σε νοιάζουν δύσκολα ξεχνιούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a place you'll visit soon or a situation you're curious about. Conversations you care about stick."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a place you'll be visiting soon or a situation you're curious about. Conversations you care about stick in the memory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un lugar al que irás pronto o una situación que te dé curiosidad. Lo que te interesa se queda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse paikka, jossa käyt pian, tai tilanne, joka kiinnostaa. Kiinnostavat keskustelut jäävät paremmin mieleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un endroit où vous irez bientôt, ou une situation qui vous intrigue. Plus une conversation vous intéresse, moins elle s’oublie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tempat yang akan segera kamu datangi atau situasi yang bikin penasaran. Percakapan yang menarik lebih awet diingat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un posto dove andrai presto o una situazione che ti incuriosisce. Le conversazioni che ti interessano restano in testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もうすぐ行く場所や気になる場面から選びましょう。興味のある会話ほど忘れにくいです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg et sted du snart skal besøke, eller en situasjon du er nysgjerrig på. Samtaler du bryr deg om, setter seg bedre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een plek waar je binnenkort heen gaat, of een situatie waar je nieuwsgierig naar bent. Gesprekken die je boeien, blijven beter hangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz miejsce, do którego niedługo się wybierasz, albo sytuację, która Cię ciekawi. Rozmowy, na których Ci zależy, zapadają w pamięć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um lugar aonde você vai em breve ou uma situação que te deixa curioso. As conversas que importam para você são as que ficam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите место, куда скоро собираетесь, или ситуацию, которая вам интересна. Разговоры, которые вам важны, запоминаются лучше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en plats du snart ska besöka eller en situation du är nyfiken på. Samtal som engagerar fastnar bättre."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกสถานที่ที่กำลังจะไป หรือสถานการณ์ที่อยากรู้ก่อนเลย ยิ่งเป็นบทสนทนาที่สนใจ ก็ยิ่งจำได้นาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakında gideceğin bir yeri ya da merak ettiğin bir durumu seç. İlgini çeken konuşmalar daha iyi akılda kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chọn nơi bạn sắp đến hoặc tình huống bạn tò mò. Hội thoại càng hợp ý càng khó quên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先挑最近要去的地方或感兴趣的场景。越感兴趣的对话越不容易忘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選一個你很快就會去的地方，或是你好奇的情境開始吧。越感興趣的對話，越不容易忘。"
          }
        }
      }
    },
