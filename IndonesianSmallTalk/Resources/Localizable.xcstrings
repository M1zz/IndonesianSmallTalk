    "작은 대화는 보통 상대방이 먼저 말을 거는 상황에서 시작해요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smalltalk beginnt meistens damit, dass dich jemand anspricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small talk usually starts when the other person speaks to you first."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small talk usually starts when the other person speaks to you first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una charla suele empezar cuando la otra persona te habla primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un small talk commence en général quand l’autre personne vous adresse la parole."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrolan ringan biasanya dimulai saat lawan bicara menyapa duluan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スモールトークは、たいてい相手から話しかけてくる場面で始まります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O small talk costuma começar quando a outra pessoa puxa assunto com você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small talk обычно начинается с того, что собеседник заговаривает первым."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闲聊通常从对方先搭话开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閒聊通常是從對方先跟你搭話開始的。"
          }
        }
      }
    },
    "잘 들리지 않았어요. 조금 더 크게 다시 말해 볼까요?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das war kaum zu hören. Sag es noch einmal etwas lauter?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't quite hear that. Try saying it a little louder?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't quite hear that. Try saying it a little louder?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se oyó bien. ¿Lo dices otra vez un poco más alto?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n’ai pas bien entendu. Pouvez-vous le redire un peu plus fort ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurang terdengar. Coba ucapkan lagi sedikit lebih keras?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく聞き取れませんでした。もう少し大きな声でもう一度言ってみましょうか?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não consegui ouvir direito. Que tal repetir um pouco mais alto?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плохо слышно. Скажите ещё раз, чуть громче?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没听清楚。再大声一点说一遍好吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒聽清楚。要不要再大聲一點說一次？"
          }
        }
      }
    },
