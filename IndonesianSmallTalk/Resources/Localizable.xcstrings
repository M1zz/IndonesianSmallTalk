    "긍정/부정 응답은 연습 점수와 코칭에 반영돼요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive und negative Antworten fließen in deine Übungspunkte und das Coaching ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive and negative replies count toward your practice score and coaching."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive and negative replies count towards your practice score and coaching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas positivas y negativas cuentan para la puntuación y los consejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses positives et négatives comptent dans votre score d’entraînement et vos conseils."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban positif/negatif memengaruhi skor latihan dan saran pelatih."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポジティブ/ネガティブな返事は練習のスコアとコーチングに反映されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respostas positivas e negativas contam na sua pontuação de prática e no coaching."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позитивные и негативные ответы влияют на баллы и подсказки тренера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "积极/消极回应会计入练习得分和指导。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正面／負面的回應會計入練習分數和教練建議。"
          }
        }
      }
    },
    "긍정/부정 표현은 연습 시 점수와 코칭에 반영돼요." : {
      "localizations" : {
        "de" : {
