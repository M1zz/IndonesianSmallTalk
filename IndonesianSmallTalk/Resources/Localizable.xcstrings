    "하루가 흘러가는 순서예요. 어디서 시작해도 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scenes in the order of the day. Start anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el orden del día. Puedes empezar por cualquiera."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Urut sesuai alur sehari. Mulai dari mana saja boleh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日の流れの順です。どこから始めても大丈夫です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按一天的顺序排列。从哪里开始都可以。"
          }
        }
      }
    },
