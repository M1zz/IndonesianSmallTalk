      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte neue Ausdrücke aus dem Smalltalk\ngleich mit der Taste + fest"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save new phrases you pick up in small talk\nright away with the + button"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save new phrases you pick up in small talk\nright away with the + button"
