    "곧 가 볼 곳, 궁금한 상황부터 고르세요. 관심 있는 대화일수록 잘 안 잊힙니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a place you'll visit soon or a situation you're curious about. Conversations you care about stick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un lugar al que irás pronto o una situación que te dé curiosidad. Lo que te interesa se queda."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tempat yang akan segera kamu datangi atau situasi yang bikin penasaran. Percakapan yang menarik lebih awet diingat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もうすぐ行く場所や気になる場面から選びましょう。興味のある会話ほど忘れにくいです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先挑最近要去的地方或感兴趣的场景。越感兴趣的对话越不容易忘。"
          }
        }
      }
    },
    "골고루 섞어서": {
      "localizations": {
        "en": {
