    "뜻을 들려준 뒤 잠깐 기다려 줘요. 소리 내어 말해 본 다음 원어민 발음으로 확인하세요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehraje význam a chvíli počká. Řekněte větu nahlas a pak si ji ověřte podle rodilého mluvčího"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betydningen afspilles, og så er der en kort pause. Sig det højt, og tjek det derefter mod en indfødts udtale"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bedeutung wird vorgelesen, dann folgt eine kurze Pause. Sprich laut mit und vergleiche es anschließend mit der Aussprache von Muttersprachlern"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παίζει το νόημα και περιμένει λίγο. Πες το φωναχτά και μετά έλεγξέ το με την προφορά ενός φυσικού ομιλητή"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It plays the meaning, then waits a moment. Say it out loud, then check it against a native speaker"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It plays the meaning, then waits a moment. Say it out loud, then check it against a native speaker"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras leer el significado, espera un momento. Dilo en voz alta y compruébalo con la pronunciación nativa"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkitys toistetaan, ja sen jälkeen odotetaan hetki. Sano se ääneen ja tarkista sitten äidinkielisen puhujan ääntämisestä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sens est lu, puis une courte pause. Dites la phrase à voix haute, puis comparez avec la prononciation d’un locuteur natif"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah arti dibacakan, ada jeda sebentar. Ucapkan dengan lantang, lalu cek dengan pelafalan penutur asli"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce il significato e poi aspetta un attimo. Dillo ad alta voce, poi confrontalo con un madrelingua"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意味を読み上げたあと、少し待ちます。声に出して言ってから、ネイティブの発音で確認しましょう"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den spiller av betydningen og venter litt. Si det høyt, og sjekk det mot en morsmålsbruker"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na de betekenis wacht het even. Zeg de zin hardop en vergelijk hem daarna met de uitspraak van een moedertaalspreker"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw usłyszysz znaczenie, potem nastąpi chwila ciszy. Powiedz zdanie na głos i sprawdź je z wymową native speakera"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca o significado e espera um instante. Fale em voz alta e depois confira com a pronúncia de um nativo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала звучит значение, затем небольшая пауза. Произнесите фразу вслух, а после сверьтесь с носителем языка"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betydelsen spelas upp och sedan väntar den en stund. Säg det högt och kontrollera sedan mot en modersmålstalare"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่นความหมายให้ฟังแล้วรอสักครู่ ลองพูดออกเสียงดู แล้วเทียบกับเสียงเจ้าของภาษา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlamı çalar, sonra kısa bir süre bekler. Yüksek sesle söyle, sonra ana dili konuşanın telaffuzuyla karşılaştır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng phát phần nghĩa rồi chờ một lát. Hãy nói thành tiếng, sau đó đối chiếu với cách phát âm của người bản xứ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放释义后会稍等片刻。先说出口，再听母语者发音来确认"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播完意思後會稍等一下。先大聲說出來，再用母語人士的發音來對照"
          }
        }
      }
    },
    "로마자 등으로 발음을 적어두면 학습에 도움이 돼요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zápis výslovnosti, třeba v romanizaci, pomáhá při učení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det hjælper at skrive udtalen ned, f.eks. med latinske bogstaver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du die Aussprache notierst, etwa in Lautschrift, lernst du leichter."
