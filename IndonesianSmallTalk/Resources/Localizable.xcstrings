    "뜻 듣고 → 먼저 말해 보고 → 정답 듣기" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslech významu → nejdřív to zkuste říct → poslech správné odpovědi"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hør betydningen → sig det selv først → hør svaret"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedeutung hören → erst selbst sprechen → Lösung hören"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άκου το νόημα → πες το πρώτος → άκου την απάντηση"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hear the meaning → say it first → hear the answer"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hear the meaning → say it first → hear the answer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha el significado → dilo tú primero → escucha la respuesta"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuule merkitys → sano se ensin itse → kuule oikea vastaus"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écouter le sens → le dire d’abord → écouter la réponse"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengar arti → coba ucapkan dulu → dengar jawaban"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascolta il significato → dillo prima tu → ascolta la risposta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意味を聞く → 先に言ってみる → 正解を聞く"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hør betydningen → si det selv først → hør svaret"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoor de betekenis → zeg het eerst zelf → hoor het antwoord"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posłuchaj znaczenia → spróbuj powiedzieć → posłuchaj odpowiedzi"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouça o significado → fale primeiro → ouça a resposta"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Услышать значение → сказать самому → услышать правильный ответ"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör betydelsen → säg det själv först → hör svaret"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟังความหมาย → ลองพูดก่อน → ฟังเฉลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlamı dinle → önce kendin söyle → doğrusunu dinle"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghe nghĩa → tự nói trước → nghe đáp án"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "听释义 → 先自己说 → 听答案"
