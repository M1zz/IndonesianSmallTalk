          }
        }
      }
    },
    "공항·숙소·식당·교통·쇼핑·관광·긴급 상황까지, 배우는 모든 언어로 열려요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flughafen, Unterkunft, Restaurant, Verkehr, Shopping, Sightseeing und Notfälle – freigeschaltet in jeder Sprache, die du lernst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airports, hotels, restaurants, transport, shopping, sightseeing and emergencies, unlocked in every language you learn."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
