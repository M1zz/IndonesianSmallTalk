    "차에 연결하고 화면 없이 귀로 연습해요. 말로 \"다음\" \"다시\" 하면 알아들어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojte se k autu a trénujte poslechem bez displeje. Řekněte „další“ nebo „znovu“ a aplikace vám porozumí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slut til bilen, og øv med ørerne uden skærm. Sig \"næste\" eller \"igen\", så forstår den det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde dich mit dem Auto und übe ohne Bildschirm, nur mit den Ohren. Sag „weiter“ oder „nochmal“, und es versteht dich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέσου με το αυτοκίνητο και εξασκήσου με τα αυτιά, χωρίς οθόνη. Πες «επόμενο» ή «ξανά» και καταλαβαίνει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to your car and practice by ear, no screen needed. Say \"next\" or \"again\" and it understands."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to your car and practise by ear, no screen needed. Say \"next\" or \"again\" and it understands."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctalo al auto y practica de oído sin mirar la pantalla. Di «siguiente» u «otra vez» y te entiende."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistä autoosi ja harjoittele korvakuulolta ilman näyttöä. Sano ”seuraava” tai ”uudelleen”, niin sovellus ymmärtää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à la voiture et entraînez-vous à l’oreille, sans écran. Dites « suivant » ou « encore » et l’appli comprend."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungkan ke mobil dan latihan lewat telinga tanpa layar. Bilang \"lanjut\" atau \"ulang\", langsung dimengerti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegati all'auto ed esercitati ascoltando, senza guardare lo schermo. Di' \"avanti\" o \"ancora\" e ti capisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車につないで画面なしで耳で練習。「次」「もう一回」と言えば伝わります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til bilen og øv med ørene, helt uten skjerm. Si «neste» eller «igjen», så forstår den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind met je auto en oefen met je oren, zonder scherm. Zeg \"volgende\" of \"opnieuw\" en het begrijpt je."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz z samochodem i ćwicz na słuch, bez patrzenia w ekran. Powiedz „dalej” lub „jeszcze raz”, a aplikacja zrozumie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte ao carro e pratique de ouvido, sem tela. Diga \"próxima\" ou \"de novo\" e ele entende."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключитесь к машине и тренируйтесь на слух, не глядя на экран. Скажите «дальше» или «ещё раз» — вас поймут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut till bilen och öva med öronen, utan skärm. Säg \"nästa\" eller \"igen\" så förstår den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อกับรถแล้วฝึกด้วยหูโดยไม่ต้องดูหน้าจอ พูดว่า \"ถัดไป\" หรือ \"อีกครั้ง\" ก็เข้าใจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arabaya bağlan ve ekrana bakmadan kulağınla pratik yap. \"Sonraki\" ya da \"tekrar\" de, seni anlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối với xe và luyện bằng tai, không cần nhìn màn hình. Hãy nói \"tiếp\" hoặc \"lại\", ứng dụng sẽ hiểu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连上车，不看屏幕用耳朵练习。说“下一个”“再来”就能听懂。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連上車子，不看螢幕，用耳朵練習。說「下一個」或「再一次」，它聽得懂。"
          }
        }
      }
    },
