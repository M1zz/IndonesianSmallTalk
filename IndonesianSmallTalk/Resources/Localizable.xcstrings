    "이 매핑은 1:1 정확한 번역이 아닌 비슷한 톤·뉘앙스 매칭이에요. 격식 자리에선 인도네시아어 슬랭 사용에 주의하세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato přiřazení nejsou přesné překlady 1:1, ale odpovídají podobným tónem a nuancí. Ve formálních situacích buďte s indonéským slangem opatrní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse oversættelser er ikke ord for ord, men matcher en tilsvarende tone og nuance. Vær forsigtig med at bruge indonesisk slang i formelle sammenhænge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zuordnungen sind keine exakten 1:1-Übersetzungen, sondern treffen einen ähnlichen Ton und eine ähnliche Nuance. Sei in förmlichen Situationen vorsichtig mit indonesischem Slang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτές οι αντιστοιχίες δεν είναι ακριβείς μεταφράσεις 1:1, αλλά ταιριάζουν σε παρόμοιο ύφος και απόχρωση. Πρόσεχε το ινδονησιακό slang σε επίσημες περιστάσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These mappings aren't exact 1:1 translations—they match a similar tone and nuance. Be careful using Indonesian slang in formal settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These mappings aren't exact 1:1 translations; they match a similar tone and nuance. Be careful using Indonesian slang in formal settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas equivalencias no son traducciones exactas, sino de tono y matiz similares. Ten cuidado con la jerga indonesia en situaciones formales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä vastaavuudet eivät ole täsmällisiä 1:1-käännöksiä vaan sävyltään ja vivahteiltaan samankaltaisia. Ole varovainen indonesialaisen slangin käytössä muodollisissa tilanteissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces correspondances ne sont pas des traductions exactes 1:1 : elles rendent un ton et une nuance proches. Dans un contexte soutenu, méfiez-vous de l’argot indonésien."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemetaan ini bukan terjemahan 1:1 yang persis, melainkan padanan nada dan nuansa yang mirip. Hati-hati memakai slang Indonesia di situasi formal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste corrispondenze non sono traduzioni esatte 1:1: richiamano un tono e una sfumatura simili. Fai attenzione a usare lo slang indonesiano in contesti formali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この対応は1対1の正確な翻訳ではなく、似たトーンやニュアンスの組み合わせです。改まった場ではインドネシア語のスラングの使用に注意してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse tilordningene er ikke nøyaktige 1:1-oversettelser, men treffer en lignende tone og nyanse. Vær forsiktig med å bruke indonesisk slang i formelle situasjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze koppelingen zijn geen exacte vertalingen, maar passen qua toon en nuance bij elkaar. Wees voorzichtig met Indonesische slang in formele situaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To mapowanie nie jest dokładnym tłumaczeniem 1:1 — dopasowuje podobny ton i niuans. W formalnych sytuacjach uważaj na indonezyjski slang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses mapeamentos não são traduções exatas 1:1 — eles combinam tom e nuance parecidos. Cuidado ao usar gírias indonésias em situações formais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это соответствие не дословный перевод, а подбор схожего тона и оттенка. В официальных ситуациях осторожнее с индонезийским сленгом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här kopplingarna är inga exakta översättningar 1:1 – de matchar en liknande ton och nyans. Var försiktig med indonesisk slang i formella sammanhang."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การจับคู่นี้ไม่ใช่คำแปลที่ตรงกันแบบหนึ่งต่อหนึ่ง แต่เป็นการจับคู่ที่มีน้ำเสียงและความรู้สึกใกล้เคียงกัน ระวังการใช้สแลงอินโดนีเซียในสถานการณ์ที่เป็นทางการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu eşleştirmeler birebir çeviri değil; benzer ton ve incelikte karşılıklar. Resmî ortamlarda Endonezce argo kullanırken dikkatli ol."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các cặp này không phải bản dịch chính xác 1:1 mà chỉ khớp về giọng điệu và sắc thái. Hãy cẩn thận khi dùng tiếng lóng Indonesia trong những hoàn cảnh trang trọng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
