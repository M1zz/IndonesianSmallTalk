          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曜日のないコース"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不分星期的课程"
          }
        }
      }
    },
    "요청문을 ChatGPT 같은 AI 에 붙여 넣으면 이 형식으로 대화를 만들어 줘요. 받은 글을 위에 붙여 넣으세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste this prompt into an AI like ChatGPT and it will write a conversation in this format. Paste the result above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega la instrucción en una IA como ChatGPT y te creará una conversación con este formato. Pega arriba el texto que recibas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel prompt ke AI seperti ChatGPT untuk membuat percakapan dalam format ini. Tempel hasilnya di atas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼文をChatGPTなどのAIに貼り付けると、この形式で会話を作ってくれます。返ってきた文章を上に貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把提示词粘贴到 ChatGPT 等 AI 中，就能生成这种格式的对话。把得到的文本粘贴到上方。"
          }
        }
      }
    },
    "우선순위": {
      "localizations": {
        "en": {
