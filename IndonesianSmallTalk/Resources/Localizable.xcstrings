    "녹음을 시작하지 못했어요. 잠시 뒤 다시 해 주세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrávání se nepodařilo spustit. Zkuste to za chvíli znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optagelsen kunne ikke starte. Prøv igen om et øjeblik."
          }
        },
        "de" : {
