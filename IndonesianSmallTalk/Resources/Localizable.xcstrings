    "발음을 들으려면 설정에서 마이크와 음성 인식을 허용해 주세요. 듣기는 지금도 할 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li si ověřit výslovnost, povolte v Nastavení mikrofon a rozpoznávání řeči. Poslouchat můžete i teď."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at få din udtale tjekket skal du give adgang til Mikrofon og Talegenkendelse i Indstillinger. Du kan stadig lytte nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um deine Aussprache zu prüfen, erlaube in den Einstellungen Mikrofon und Spracherkennung. Anhören kannst du dir die Sätze weiterhin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να ελέγξεις την προφορά σου, επίτρεψε το Μικρόφωνο και την Αναγνώριση ομιλίας στις Ρυθμίσεις. Ακούσματα μπορείς να κάνεις και τώρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To check your pronunciation, allow Microphone and Speech Recognition in Settings. You can still listen now."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To check your pronunciation, allow Microphone and Speech Recognition in Settings. You can still listen now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para comprobar tu pronunciación, permite el micrófono y el reconocimiento de voz en Ajustes. Ya puedes escuchar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat tarkistaa ääntämisesi, salli mikrofoni ja puheentunnistus Asetuksissa. Kuuntelu onnistuu silti nyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vérifier votre prononciation, autorisez le micro et la reconnaissance vocale dans Réglages. L’écoute reste disponible dès maintenant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk melatih pelafalan, izinkan mikrofon dan pengenalan ucapan di Pengaturan. Mendengarkan tetap bisa sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per controllare la pronuncia, consenti Microfono e Riconoscimento vocale in Impostazioni. Per ora puoi comunque ascoltare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "発音を聞き取るには、設定でマイクと音声認識を許可してください。聞く練習は今でもできます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å få sjekket uttalen må du gi Mikrofon og Talegjenkjenning tilgang i Innstillinger. Du kan fortsatt lytte nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Microfoon en Spraakherkenning toe in Instellingen om je uitspraak te laten controleren. Luisteren kan nu al."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby sprawdzać wymowę, zezwól w Ustawieniach na mikrofon i rozpoznawanie mowy. Słuchać możesz już teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para checar sua pronúncia, permita Microfone e Reconhecimento de Fala nos Ajustes. Você ainda pode ouvir normalmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы проверять произношение, разрешите в «Настройках» микрофон и распознавание речи. Слушать можно и сейчас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt mikrofon och taligenkänning i Inställningar för att kontrollera ditt uttal. Du kan fortfarande lyssna nu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการให้ตรวจการออกเสียง โปรดอนุญาตไมโครโฟนและการรู้จำเสียงพูดในการตั้งค่า ตอนนี้ยังฟังได้ตามปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telaffuzunu kontrol edebilmem için Ayarlar'dan Mikrofon ve Konuşma Tanıma izni ver. Dinleme şimdi de çalışıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để kiểm tra phát âm, hãy cho phép Micro và Nhận dạng giọng nói trong Cài đặt. Bạn vẫn có thể nghe ngay bây giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要练习发音，请在设置中允许使用麦克风和语音识别。现在仍可以收听。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要檢查發音，請到「設定」中允許麥克風與語音辨識。目前仍可以收聽。"
          }
        }
      }
    },
