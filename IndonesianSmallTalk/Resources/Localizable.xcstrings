    "A 가 상대방이면 B 는 내가 말하는 쪽이에요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je A váš protějšek, B jste vy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis A er den anden person, er B dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn A dein Gegenüber ist, bist du B."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν το A είναι ο συνομιλητής σου, το B είσαι εσύ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If A is the other person, B is you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If A is the other person, B is you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si A es la otra persona, B eres tú."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos A on toinen ihminen, B olet sinä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si A est votre interlocuteur, B, c’est vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika A adalah lawan bicara, B adalah Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se A è l'altra persona, B sei tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A が相手なら、B は自分が話す側です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis A er den andre personen, er B deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als A de ander is, ben jij B."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli A to rozmówca, to B jesteś Ty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se A é a outra pessoa, B é você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если A — собеседник, то B — это вы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om A är den andra personen är B du."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้า A คืออีกฝ่าย B ก็คือฝั่งของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A karşındaki kişiyse B sensin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu A là người đối diện thì B là bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 A 是对方，B 就是你自己。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 A 是對方，B 就是你自己。"
          }
        }
      }
    },
