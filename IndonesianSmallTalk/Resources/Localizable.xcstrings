    "운전 모드": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Driving mode"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo conducción"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode mengemudi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運転モード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驾驶模式"
          }
        }
      }
    },
    "운전 중에는 화면을 만지지 마세요. 운전대의 다음·이전·재생 버튼도 쓸 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't touch the screen while driving. You can also use the next, previous and play buttons on your steering wheel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No toques la pantalla mientras manejas. También puedes usar los botones de siguiente, anterior y reproducir del volante."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan sentuh layar saat menyetir. Kamu juga bisa pakai tombol berikutnya, sebelumnya, dan putar di setir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運転中は画面に触れないでください。ハンドルの次へ・前へ・再生ボタンも使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驾驶时请不要触摸屏幕。也可以使用方向盘上的下一首、上一首和播放按钮。"
          }
        }
      }
    },
    "운전대 버튼으로 조작": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steering-wheel controls"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control con los botones del volante"
          }
        },
        "id": {
