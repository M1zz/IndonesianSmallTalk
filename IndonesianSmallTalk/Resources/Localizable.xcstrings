        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hear the meaning, say it first, then hear the answer"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hear the meaning, say it first, then hear the answer"
          }
        },
