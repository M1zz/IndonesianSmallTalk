    "CarPlay나 블루투스로 연결한 뒤 퇴근길 모드를 켜면 화면을 보지 않아도 대화가 차례로 흘러나와요" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde dich über CarPlay oder Bluetooth und schalte den Feierabend-Modus ein. Das Gespräch läuft Zeile für Zeile ab, ganz ohne Blick auf den Bildschirm"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect via CarPlay or Bluetooth and turn on Commute Mode. The conversation plays line by line, no screen needed"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect via CarPlay or Bluetooth and turn on Commute Mode. The conversation plays line by line, no screen needed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate por CarPlay o Bluetooth y activa el modo trayecto: la conversación sonará paso a paso sin mirar la pantalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous via CarPlay ou Bluetooth et activez le mode trajet : la conversation défile phrase après phrase, sans regarder l’écran"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan lewat CarPlay atau Bluetooth lalu nyalakan Mode Perjalanan, percakapan akan diputar berurutan tanpa perlu melihat layar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CarPlayまたはBluetoothで接続してから通勤モードをオンにすると、画面を見なくても会話が順番に流れます"
          }
        },
