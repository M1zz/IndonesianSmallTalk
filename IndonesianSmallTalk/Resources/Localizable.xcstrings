          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без дневного лимита сцен. Тренируйтесь на слух всю дорогу до работы и обратно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
