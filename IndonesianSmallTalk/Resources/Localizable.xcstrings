    "카페에서, 길에서, 영상에서 — 어라 이 말이 뭐지? 싶은 한 줄을 발견" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V kavárně, na ulici, ve videu – narazíte na větu a řeknete si: „Počkat, co to znamená?“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På en café, på gaden, i en video — du opdager en linje og tænker: \"Vent, hvad betyder det?\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Café, auf der Straße, in einem Video – du entdeckst eine Zeile und fragst dich: „Moment, was heißt das?“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε έναν καφέ, στον δρόμο, σε ένα βίντεο — εντοπίζεις μια φράση και αναρωτιέσαι «Για στάσου, τι σημαίνει αυτό;»"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At a café, on the street, in a video — you spot a line and think, \"Wait, what does that mean?\""
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At a café, on the street, in a video — you spot a line and think, \"Wait, what does that mean?\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la cafetería, en la calle, en un video: encuentras una frase y piensas «¿y esto qué significa?»"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahvilassa, kadulla, videolla — huomaat rivin ja mietit: ”Hetkinen, mitä se tarkoittaa?”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans un café, dans la rue, dans une vidéo — vous repérez une phrase et vous vous demandez : « Mais qu’est-ce que ça veut dire ? »"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di kafe, di jalan, di video — menemukan satu kalimat yang bikin bertanya \"Eh, ini artinya apa?\""
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In un bar, per strada, in un video: noti una riga e pensi \"Aspetta, cosa vuol dire?\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カフェで、道で、動画で — 「あれ、これ何て意味?」と思う一文を見つける"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På en kafé, på gaten, i en video – du legger merke til en setning og tenker: «Hva betyr egentlig det?»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In een café, op straat, in een video — je ziet een regel en denkt: \"Wacht, wat betekent dat?\""
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W kawiarni, na ulicy, w filmiku — wpada Ci w ucho zdanie i myślisz: „Moment, co to znaczy?”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num café, na rua, num vídeo — você vê uma frase e pensa: \"Peraí, o que isso quer dizer?\""
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В кафе, на улице, в видео — вы замечаете фразу и думаете: «Стоп, что это значит?»"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På ett café, på gatan, i en video – du ser en rad och tänker: \"Vänta, vad betyder det?\""
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่คาเฟ่ ริมถนน ในวิดีโอ — เจอประโยคหนึ่งแล้วอดสงสัยไม่ได้ว่า \"เอ๊ะ แปลว่าอะไร\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kafede, sokakta, bir videoda — \"Dur bir dakika, bu ne demek?\" dediğin bir satırı fark et"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở quán cà phê, ngoài đường, trong video — bạn bắt gặp một câu và tự hỏi: \"Ủa, câu này nghĩa là gì nhỉ?\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在咖啡店、街上、视频里 — 发现一句“咦，这是什么意思？”的话"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在咖啡廳、在街上、在影片裡 — 看到一句「咦，這句是什麼意思？」"
          }
        }
      }
    },
