    "필수: 무조건 외워야 함 / 편의: 알면 좋음 / 심화: 자연스러움 추가" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezbytné: nutno se naučit / Užitečné: dobré znát / Hlubší: zní přirozeněji"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigtigt: skal læres udenad / Praktisk: godt at kende / Dybere: lyder mere naturligt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unverzichtbar: unbedingt lernen / Nützlich: gut zu wissen / Vertiefung: klingt natürlicher"
          }
        },
        "el" : {
