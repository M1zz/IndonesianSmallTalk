    "정답은 없어요. 가능한 답변을 떠올려 적는 그 과정 자체가 그 상황 학습이에요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správná odpověď neexistuje. Učíte se tím, že vymýšlíte a zapisujete možné odpovědi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er intet rigtigt svar. Det er netop ved at finde på og skrive mulige svar, at du lærer situationen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine richtige Antwort. Mögliche Antworten zu überlegen und aufzuschreiben, ist genau das, womit du diese Situation lernst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει μία σωστή απάντηση. Το να σκέφτεσαι και να γράφεις πιθανές απαντήσεις είναι ο τρόπος να μάθεις αυτή την κατάσταση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no right answer. Thinking up and writing possible replies is how you learn that situation."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no right answer. Thinking up and writing possible replies is how you learn that situation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay respuesta correcta. Pensar y escribir respuestas posibles ya es aprender esa situación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oikeaa vastausta ei ole. Mahdollisten vastausten miettiminen ja kirjoittaminen on juuri se, miten opit tilanteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a pas de bonne réponse. Imaginer et écrire les réponses possibles, c’est déjà apprendre cette situation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada jawaban benar. Proses membayangkan dan menulis jawaban yang mungkin itulah cara mempelajari situasinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non esiste una risposta giusta. Pensare e scrivere le possibili risposte è proprio il modo di imparare quella situazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正解はありません。ありうる返事を思い浮かべて書く、その過程こそがその場面の学習です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes ikke noe fasitsvar. Å tenke ut og skrive mulige svar er selve måten du lærer situasjonen på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen goed antwoord. Mogelijke antwoorden bedenken en opschrijven is precies hoe je die situatie leert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ma jednej dobrej odpowiedzi. Wymyślanie i zapisywanie możliwych odpowiedzi to właśnie nauka tej sytuacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não existe resposta certa. Pensar e escrever respostas possíveis é justamente como você aprende aquela situação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правильного ответа нет. Придумывать и записывать возможные ответы — и значит осваивать ситуацию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns inget rätt svar. Att fundera ut och skriva möjliga svar är hur du lär dig situationen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีคำตอบที่ถูกเพียงข้อเดียว การนึกและเขียนคำตอบที่เป็นไปได้นั่นแหละคือการเรียนรู้สถานการณ์นั้น"
