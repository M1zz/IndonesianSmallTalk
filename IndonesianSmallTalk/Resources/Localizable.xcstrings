    "CarPlay나 블루투스로 연결한 뒤 퇴근길 모드를 켜면 화면을 보지 않아도 대화가 차례로 흘러나와요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojte se přes CarPlay nebo Bluetooth a zapněte režim dojíždění. Konverzace pak zní větu po větě, bez pohledu na displej"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slut telefonen til via CarPlay eller Bluetooth, og slå pendlertilstand til. Så afspilles samtalen replik for replik, uden at du skal se på skærmen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde dich über CarPlay oder Bluetooth und schalte den Feierabend-Modus ein. Das Gespräch läuft Zeile für Zeile ab, ganz ohne Blick auf den Bildschirm"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέσου μέσω CarPlay ή Bluetooth και άνοιξε τη Λειτουργία διαδρομής. Η συζήτηση παίζει πρόταση προς πρόταση, χωρίς να κοιτάς την οθόνη"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect via CarPlay or Bluetooth and turn on Commute Mode. The conversation plays line by line, no screen needed"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect via CarPlay or Bluetooth and turn on Commute Mode. The conversation plays line by line, no screen needed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate por CarPlay o Bluetooth y activa el modo trayecto: la conversación sonará paso a paso sin mirar la pantalla"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistä CarPlayn tai Bluetoothin kautta ja ota työmatkatila käyttöön. Keskustelu soi lause kerrallaan, eikä näyttöä tarvitse katsoa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous via CarPlay ou Bluetooth et activez le mode trajet : la conversation défile phrase après phrase, sans regarder l’écran"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan lewat CarPlay atau Bluetooth lalu nyalakan Mode Perjalanan, percakapan akan diputar berurutan tanpa perlu melihat layar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegati con CarPlay o Bluetooth e attiva la Modalità tragitto: la conversazione va avanti riga dopo riga, senza guardare lo schermo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CarPlayまたはBluetoothで接続してから通勤モードをオンにすると、画面を見なくても会話が順番に流れます"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til via CarPlay eller Bluetooth og slå på pendlermodus. Samtalen spilles av replikk for replikk, helt uten skjerm"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind via CarPlay of Bluetooth en zet de Onderweg-modus aan. Het gesprek wordt regel voor regel afgespeeld, je hoeft niet naar het scherm te kijken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz się przez CarPlay lub Bluetooth i włącz Tryb dojazdu. Rozmowa odtwarza się kwestia po kwestii, bez patrzenia w ekran"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte pelo CarPlay ou Bluetooth e ative o Modo Trajeto. A conversa toca fala por fala, sem precisar olhar a tela"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите телефон по CarPlay или Bluetooth и включите режим «В пути» — диалог зазвучит по реплике, смотреть на экран не нужно"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut via CarPlay eller Bluetooth och slå på pendlarläget. Samtalet spelas upp replik för replik, utan att du behöver titta på skärmen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อผ่าน CarPlay หรือบลูทูธแล้วเปิดโหมดเดินทาง บทสนทนาจะเล่นทีละประโยคโดยไม่ต้องมองหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CarPlay veya Bluetooth ile bağlanıp Yol Modu'nu aç. Konuşma ekrana bakmadan satır satır oynatılır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối qua CarPlay hoặc Bluetooth rồi bật Chế độ đi làm. Hội thoại sẽ phát lần lượt từng câu, không cần nhìn màn hình"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接 CarPlay 或蓝牙后打开通勤模式，不用看屏幕，对话也会依次播放"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 CarPlay 或藍牙連線後開啟通勤模式，不用看螢幕，對話就會一句接一句播放"
          }
        }
      }
    },
    "Claude AI가 %@ 대화 트리 + 단어장 + 문법 노트를 한 번에 만들어줍니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
