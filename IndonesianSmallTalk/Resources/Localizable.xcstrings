        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語ごとにマイフレーズ・マイシナリオ・単語帳が別々に保存されます。いつでも切り替えられます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minhas frases, meus cenários e o vocabulário são salvos separadamente para cada idioma. Você pode voltar a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мои фразы, мои сценарии и словарь хранятся отдельно для каждого языка. Переключиться обратно можно в любой момент."
