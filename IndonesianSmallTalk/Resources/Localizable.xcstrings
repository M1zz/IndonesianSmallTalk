    "iCloud 로 공유 — 만든 후 카드에서 공유 링크 보내기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share via iCloud — after creating it, send a share link from the card"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir por iCloud: después de crearlo, envía el enlace desde la tarjeta"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan via iCloud — kirim tautan dari kartu setelah dibuat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudで共有 — 作成後、カードから共有リンクを送信"
