    "키보드에서 어느 언어를 보고 어느 언어를 입력할지. 키보드 우상단 칩으로도 즉시 전환할 수 있어요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche Sprache du auf der Tastatur siehst und welche du tippst. Mit dem Chip oben rechts auf der Tastatur wechselst du sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which language you see and which you type on the keyboard. You can also switch instantly with the chip at the top right of the keyboard."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which language you see and which you type on the keyboard. You can also switch instantly with the chip at the top right of the keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué idioma ves y en cuál escribes en el teclado. También puedes cambiarlo al instante con el chip de la esquina superior derecha del teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle langue voir et quelle langue saisir sur le clavier. Vous pouvez aussi basculer d’un geste avec la pastille en haut à droite du clavier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa yang dilihat dan bahasa yang diketik di keyboard. Bisa langsung diganti lewat chip di kanan atas keyboard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードでどの言語を見てどの言語を入力するか。キーボード右上のチップでもすぐに切り替えられます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual idioma você vê e qual você digita no teclado. Você também pode alternar na hora pelo botão no canto superior direito do teclado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На каком языке вы видите подсказки и на каком печатаете на клавиатуре. Переключиться сразу можно и кнопкой в правом верхнем углу клавиатуры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置键盘上看哪种语言、输入哪种语言。也可以用键盘右上角的标签随时切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵盤上要看哪種語言、輸入哪種語言。也可以用鍵盤右上角的標籤立即切換。"
          }
        }
      }
    },
