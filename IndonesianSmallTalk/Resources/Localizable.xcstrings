    "텍스트 모드에서 \"음성으로\" 칩 → 발화 → 가장 가까운 선택지 자동 매칭": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In text mode, tap the \"Voice\" chip → speak → it automatically matches the closest option"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En modo texto, chip «Por voz» → habla → se elige automáticamente la opción más parecida"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di mode teks, chip \"Dengan suara\" → bicara → otomatis dicocokkan ke pilihan terdekat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
