    "뜻을 듣고, 먼저 말해 보고, 정답을 들어요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslechněte si význam, zkuste větu nejdřív říct sami a pak si poslechněte správnou odpověď"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hør betydningen, sig det selv først, og hør så svaret"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedeutung hören, erst selbst sprechen, dann die Lösung hören"
