    "한국어 젠지어와 비슷한 의미·톤의 인도네시아어 슬랭. 추가/수정/삭제하면 키보드에 즉시 반영돼요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indonesischer Slang mit ähnlicher Bedeutung und ähnlichem Ton wie koreanischer Gen-Z-Slang. Wenn du etwas hinzufügst, änderst oder löschst, wird die Tastatur sofort aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indonesian slang with a similar meaning and tone to Korean Gen Z slang. Add, edit, or delete, and the keyboard updates right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indonesian slang with a similar meaning and tone to Korean Gen Z slang. Add, edit or delete, and the keyboard updates right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jerga indonesia con significado y tono parecidos a la jerga de la Generación Z coreana. Lo que añadas, edites o elimines se refleja al instante en el teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De l’argot indonésien au sens et au ton proches de l’argot coréen de la génération Z. Ajoutez, modifiez ou supprimez : le clavier se met à jour aussitôt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slang Indonesia dengan arti dan nada mirip bahasa gaul Gen Z Korea. Tambah/ubah/hapus langsung diterapkan di keyboard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "韓国語のZ世代語と似た意味・トーンのインドネシア語スラング。追加・編集・削除するとキーボードにすぐ反映されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gírias indonésias com significado e tom parecidos com as gírias da Geração Z coreana. Adicione, edite ou exclua, e o teclado é atualizado na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индонезийский сленг, близкий по смыслу и тону к корейскому сленгу поколения Z. Добавляйте, меняйте или удаляйте — клавиатура сразу обновится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与韩语网络流行语意思、语气相近的印尼语俚语。添加、编辑或删除后会立即同步到键盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與韓國 Z 世代用語意思、語氣相近的印尼語俚語。新增、編輯或刪除後，鍵盤會立即更新。"
          }
        }
      }
    },
