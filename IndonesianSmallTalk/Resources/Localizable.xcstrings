    "한국어 ↔ 인도네시아어 슬랭": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Korean ↔ Indonesian slang"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coreano ↔ jerga indonesia"
          }
        },
        "id": {
          "stringUnit": {
