          }
        }
      }
    },
    "iCloud 로 시나리오 양방향 공유 — 둘이 같이 트리를 키울 수 있음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two-way scenario sharing via iCloud — grow the tree together"
