        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez dans le même scénario pour ajouter des branches, jusqu’à visualiser toutes les conversations possibles dans cette situation"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk lagi ke skenario yang sama dan tambah cabang, sampai semua kemungkinan percakapan di situasi itu terbayang"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じシナリオに戻って分岐を追加。その場面で起こりうる会話が頭に浮かぶまで"
