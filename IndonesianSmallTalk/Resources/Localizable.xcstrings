    "같은 단어를 여러 상황에서 본 예문일수록 외우기 쉬워요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wörter prägen sich leichter ein, wenn du sie in Beispielen aus verschiedenen Situationen gesehen hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Words are easier to remember when you've seen them in examples from different situations."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Words are easier to remember when you've seen them in examples from different situations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una palabra se recuerda mejor si la ves en ejemplos de distintas situaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mot se retient mieux quand on l’a vu dans des exemples de situations variées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contoh kalimat dari berbagai situasi untuk kata yang sama lebih mudah diingat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ単語をいろいろな場面の例文で見るほど覚えやすくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fica mais fácil lembrar das palavras quando você as viu em exemplos de situações diferentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слова легче запоминаются, если встретить их в примерах из разных ситуаций."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一个单词在不同场景中见过的例句越多，就越容易记住。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
