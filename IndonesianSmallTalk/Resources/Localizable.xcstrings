    "뜻 듣고 → 먼저 말해 보고 → 정답 듣기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hear the meaning → say it first → hear the answer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha el significado → dilo tú primero → escucha la respuesta"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengar arti → coba ucapkan dulu → dengar jawaban"
          }
        },
        "ja": {
