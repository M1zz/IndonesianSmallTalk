    "다른 앱에서도 말문 키보드 → 뜻을 보고 탭하면 배우는 언어로 입력": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In any app, use Malmun Keyboard → see the meaning and tap to type it in the language you're learning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En otras apps, con el Teclado Malmun: mira el significado y toca para escribirlo en el idioma que aprendes"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di app lain pun: Keyboard Malmun → lihat arti, ketuk untuk mengetik dalam bahasa yang dipelajari"
