    "작은 대화는 보통 상대방이 먼저 말을 거는 상황에서 시작해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small talk usually starts when the other person speaks to you first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una charla suele empezar cuando la otra persona te habla primero."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrolan ringan biasanya dimulai saat lawan bicara menyapa duluan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スモールトークは、たいてい相手から話しかけてくる場面で始まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闲聊通常从对方先搭话开始。"
          }
        }
      }
    },
    "잘 들리지 않았어요. 조금 더 크게 다시 말해 볼까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't quite hear that. Try saying it a little louder?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se oyó bien. ¿Lo dices otra vez un poco más alto?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurang terdengar. Coba ucapkan lagi sedikit lebih keras?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく聞き取れませんでした。もう少し大きな声でもう一度言ってみましょうか?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没听清楚。再大声一点说一遍好吗？"
          }
        }
      }
    },
    "잘했어요!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Well done!"
