    },
    "👍 긍정적인 답을 조금 더 고르면 대화가 더 부드러워져요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "👍 Pick a few more positive replies to keep the conversation smooth."
          }
        },
