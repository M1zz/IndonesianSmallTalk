    "인도네시아어·영어·일본어·중국어·스페인어·한국어 중에서 골라 배워요. 앱 화면도 6개 언어로 볼 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybírejte z indonéštiny, angličtiny, japonštiny, čínštiny, španělštiny a korejštiny. Samotná aplikace je také v 6 jazycích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg mellem indonesisk, engelsk, japansk, kinesisk, spansk og koreansk. Selve appen findes også på 6 sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle zwischen Indonesisch, Englisch, Japanisch, Chinesisch, Spanisch und Koreanisch. Die App selbst gibt es ebenfalls in 6 Sprachen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε ανάμεσα σε Ινδονησιακά, Αγγλικά, Ιαπωνικά, Κινεζικά, Ισπανικά και Κορεατικά. Και η ίδια η εφαρμογή διατίθεται σε 6 γλώσσες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose from Indonesian, English, Japanese, Chinese, Spanish and Korean. The app itself also comes in 6 languages."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose from Indonesian, English, Japanese, Chinese, Spanish and Korean. The app itself also comes in 6 languages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige entre indonesio, inglés, japonés, chino, español y coreano. La app también está en 6 idiomas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse opiskeltava kieli: indonesia, englanti, japani, kiina, espanja tai korea. Myös sovelluksen oman kielen voi vaihtaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez parmi l’indonésien, l’anglais, le japonais, le chinois, l’espagnol et le coréen. L’appli elle-même existe aussi en 6 langues."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih dari bahasa Indonesia, Inggris, Jepang, Mandarin, Spanyol, dan Korea. Aplikasinya juga tersedia dalam 6 bahasa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli tra indonesiano, inglese, giapponese, cinese, spagnolo e coreano. Anche l'app è disponibile in 6 lingue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インドネシア語・英語・日本語・中国語・スペイン語・韓国語から選んで学べます。アプリの画面も6言語に対応。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg mellom indonesisk, engelsk, japansk, kinesisk, spansk og koreansk. Selve appen finnes også på 6 språk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies uit Indonesisch, Engels, Japans, Chinees, Spaans en Koreaans. De app zelf is ook in 6 talen beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz język: indonezyjski, angielski, japoński, chiński, hiszpański lub koreański. Sama aplikacja też jest dostępna w 6 językach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha entre indonésio, inglês, japonês, chinês, espanhol e coreano. O próprio app também vem em 6 idiomas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирайте индонезийский, английский, японский, китайский, испанский или корейский. Само приложение тоже доступно на этих 6 языках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj mellan indonesiska, engelska, japanska, kinesiska, spanska och koreanska. Själva appen finns också på 6 språk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกเรียนได้จากภาษาอินโดนีเซีย อังกฤษ ญี่ปุ่น จีน สเปน และเกาหลี หน้าจอแอปก็ใช้ได้ 6 ภาษาเช่นกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endonezce, İngilizce, Japonca, Çince, İspanyolca ve Korece arasından seçerek öğren. Uygulamanın kendisi de 6 dilde kullanılabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn học tiếng Indonesia, tiếng Anh, tiếng Nhật, tiếng Trung, tiếng Tây Ban Nha hoặc tiếng Hàn. Giao diện ứng dụng cũng có sẵn bằng 6 ngôn ngữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可从印尼语、英语、日语、中文、西班牙语、韩语中选择学习。应用界面也支持 6 种语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從印尼語、英語、日語、中文、西班牙語和韓語中選一種來學。App 介面也提供這 6 種語言。"
          }
        }
      }
    },
    "인도네시아어처럼 다른 언어에도 처음부터 꼭 필요한 단어가 들어 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stejně jako indonéština budou mít i další jazyky od začátku vestavěná nezbytná slovíčka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligesom indonesisk får andre sprog de vigtigste ord indbygget fra start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie beim Indonesischen steckt auch in anderen Sprachen von Anfang an der unverzichtbare Grundwortschatz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όπως στα Ινδονησιακά, και οι άλλες γλώσσες θα ξεκινούν με ενσωματωμένες τις βασικές λέξεις που χρειάζεσαι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like Indonesian, other languages will start with the essential words built in."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like Indonesian, other languages will start with the essential words built in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como el indonesio, los demás idiomas traerán las palabras esenciales desde el inicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuten indonesiassa, myös muissa kielissä on alusta asti mukana välttämättömät sanat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme pour l’indonésien, les autres langues proposeront d’emblée les mots essentiels."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seperti bahasa Indonesia, bahasa lain juga akan langsung berisi kata-kata penting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come per l'indonesiano, anche le altre lingue partiranno con le parole essenziali già incluse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インドネシア語のように、ほかの言語にも最初から必須単語が入ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som på indonesisk kommer også andre språk til å ha de aller viktigste ordene innebygd fra start."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net als bij het Indonesisch zitten ook in andere talen de belangrijkste woorden er vanaf het begin in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podobnie jak indonezyjski, także inne języki będą od początku zawierać niezbędne słownictwo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assim como no indonésio, os outros idiomas também vão começar com as palavras essenciais já incluídas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как и в индонезийском, в других языках с самого начала будут самые нужные слова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precis som indonesiskan får andra språk de viktigaste orden inbyggda från början."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหมือนภาษาอินโดนีเซีย ภาษาอื่น ๆ ก็จะมีคำศัพท์จำเป็นตั้งแต่เริ่มต้นไว้ให้ในแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endonezce gibi diğer dillerde de en gerekli kelimeler baştan hazır gelecek."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giống tiếng Indonesia, các ngôn ngữ khác cũng sẽ có sẵn những từ thiết yếu ngay từ đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像印尼语一样，其他语言也会内置必备单词。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟印尼語一樣，其他語言一開始也會內建最必要的單字。"
          }
        }
      }
    },
