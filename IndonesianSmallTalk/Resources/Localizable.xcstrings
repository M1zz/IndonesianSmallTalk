    "뜻을 듣고, 먼저 말해 보고, 정답을 들어요" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedeutung hören, erst selbst sprechen, dann die Lösung hören"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hear the meaning, say it first, then hear the answer"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hear the meaning, say it first, then hear the answer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha el significado, dilo tú primero y luego escucha la respuesta"
          }
        },
        "fr" : {
          "stringUnit" : {
