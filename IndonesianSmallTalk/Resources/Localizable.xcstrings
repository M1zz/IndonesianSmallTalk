    "저장에 실패했어요. iCloud 로그인을 확인해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save. Please check that you're signed in to iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar. Comprueba que iniciaste sesión en iCloud."
