    "누가 말하는지 알 수 없어요. A: 또는 B: 로 시작해 주세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze poznat, kdo mluví. Začněte každý řádek písmenem A: nebo B:."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke se, hvem der taler. Start hver linje med A: eller B:."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
