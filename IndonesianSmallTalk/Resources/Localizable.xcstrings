    "%@ 단어를 + 로 직접 추가해서\n플래시카드로 학습해 보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add %@ words with +\nand study them with flashcards"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade palabras en %@ con +\ny estúdialas con tarjetas"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan kata %@ dengan +\nlalu pelajari dengan flashcard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の単語を + で追加して\nフラッシュカードで学習しましょう"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 + 添加%@单词，\n用闪卡来学习吧"
          }
        }
      }
    },
