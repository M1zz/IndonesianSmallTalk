    "ㅋㅋㅋ → wkwkwk / 헐 → Anjir 같은 매핑": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappings like lol → wkwkwk / OMG → Anjir"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equivalencias como jajaja → wkwkwk / ¡No manches! → Anjir"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "kkk → wkwkwk / heol → Anjir dan sejenisnya"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
