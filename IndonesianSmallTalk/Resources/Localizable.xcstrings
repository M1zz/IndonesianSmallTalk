    "앞 장면에서 배운 표현을 알아야 풀리는 구조가 아닙니다. 어디를 열어도 첫 마디부터 시작해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't need phrases from earlier scenes to follow along. Wherever you open, it starts from the first line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas saber las frases de escenas anteriores. Abras la que abras, empiezas desde la primera frase."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak perlu tahu frasa dari adegan sebelumnya. Buka di mana saja, mulai dari kalimat pertama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のシーンで学んだ表現を知らないと進めない仕組みではありません。どこを開いても最初のひとことから始まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不需要先学会前面场景的表达。无论打开哪里，都从开场白开始。"
          }
        }
      }
    },
    "앞에서부터 안 해도 됩니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No need to start from the beginning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hace falta empezar por el principio"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak harus dari awal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初から順にやらなくても大丈夫です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不必从头开始"
          }
        }
      }
    },
