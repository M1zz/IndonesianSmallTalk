    "카페에서, 길에서, 영상에서 — 어라 이 말이 뭐지? 싶은 한 줄을 발견" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Café, auf der Straße, in einem Video – du entdeckst eine Zeile und fragst dich: „Moment, was heißt das?“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At a café, on the street, in a video — you spot a line and think, \"Wait, what does that mean?\""
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At a café, on the street, in a video — you spot a line and think, \"Wait, what does that mean?\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la cafetería, en la calle, en un video: encuentras una frase y piensas «¿y esto qué significa?»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans un café, dans la rue, dans une vidéo — vous repérez une phrase et vous vous demandez : « Mais qu’est-ce que ça veut dire ? »"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di kafe, di jalan, di video — menemukan satu kalimat yang bikin bertanya \"Eh, ini artinya apa?\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カフェで、道で、動画で — 「あれ、これ何て意味?」と思う一文を見つける"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num café, na rua, num vídeo — você vê uma frase e pensa: \"Peraí, o que isso quer dizer?\""
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В кафе, на улице, в видео — вы замечаете фразу и думаете: «Стоп, что это значит?»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在咖啡店、街上、视频里 — 发现一句“咦，这是什么意思？”的话"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在咖啡廳、在街上、在影片裡 — 看到一句「咦，這句是什麼意思？」"
          }
        }
      }
    },
