    "키보드에서 어느 언어를 보고 어느 언어를 입력할지. 키보드 우상단 칩으로도 즉시 전환할 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Který jazyk na klávesnici uvidíte a který budete psát. Můžete také okamžitě přepnout čipem vpravo nahoře na klávesnici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilket sprog du ser, og hvilket du skriver på tastaturet. Du kan også skifte med det samme med chippen øverst til højre på tastaturet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche Sprache du auf der Tastatur siehst und welche du tippst. Mit dem Chip oben rechts auf der Tastatur wechselst du sofort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ποια γλώσσα βλέπεις και ποια πληκτρολογείς στο πληκτρολόγιο. Μπορείς να αλλάξεις αμέσως και από το chip πάνω δεξιά στο πληκτρολόγιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which language you see and which you type on the keyboard. You can also switch instantly with the chip at the top right of the keyboard."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which language you see and which you type on the keyboard. You can also switch instantly with the chip at the top right of the keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué idioma ves y en cuál escribes en el teclado. También puedes cambiarlo al instante con el chip de la esquina superior derecha del teclado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minkä kielen näet ja minkä kielen kirjoitat näppäimistöllä. Voit vaihtaa heti myös näppäimistön oikean yläkulman painikkeesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle langue voir et quelle langue saisir sur le clavier. Vous pouvez aussi basculer d’un geste avec la pastille en haut à droite du clavier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa yang dilihat dan bahasa yang diketik di keyboard. Bisa langsung diganti lewat chip di kanan atas keyboard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale lingua vedi e quale scrivi sulla tastiera. Puoi anche cambiare subito con il selettore in alto a destra sulla tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードでどの言語を見てどの言語を入力するか。キーボード右上のチップでもすぐに切り替えられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilket språk du ser, og hvilket du skriver på tastaturet. Du kan også bytte umiddelbart med brikken øverst til høyre på tastaturet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welke taal je op het toetsenbord ziet en welke je typt. Je kunt ook direct wisselen met de chip rechtsboven op het toetsenbord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Który język widzisz, a który wpisujesz na klawiaturze. Możesz też przełączać je od razu za pomocą znacznika w prawym górnym rogu klawiatury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual idioma você vê e qual você digita no teclado. Você também pode alternar na hora pelo botão no canto superior direito do teclado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На каком языке вы видите подсказки и на каком печатаете на клавиатуре. Переключиться сразу можно и кнопкой в правом верхнем углу клавиатуры."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilket språk du ser och vilket du skriver på tangentbordet. Du kan också byta direkt med brickan uppe till höger på tangentbordet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกว่าบนคีย์บอร์ดจะดูภาษาไหนและพิมพ์ภาษาไหน สลับได้ทันทีด้วยชิปที่มุมขวาบนของคีย์บอร์ดเช่นกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klavyede hangi dili görüp hangisini yazacağın. Klavyenin sağ üstündeki çiple de anında değiştirebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn ngôn ngữ bạn nhìn thấy và ngôn ngữ bạn gõ trên bàn phím. Bạn cũng có thể chuyển ngay bằng chip ở góc trên bên phải bàn phím."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置键盘上看哪种语言、输入哪种语言。也可以用键盘右上角的标签随时切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵盤上要看哪種語言、輸入哪種語言。也可以用鍵盤右上角的標籤立即切換。"
          }
        }
      }
    },
