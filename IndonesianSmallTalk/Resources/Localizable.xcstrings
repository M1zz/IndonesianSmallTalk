    },
    "오늘 무료 장면 %lld개를 다 들었어요. 말문 Pro로 계속 들을 수 있어요.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You've heard today's %lld free scene. Keep listening with Malmun Pro."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You've heard today's %lld free scenes. Keep listening with Malmun Pro."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ya escuchaste la %lld escena gratis de hoy. Sigue con Malmun Pro."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ya escuchaste las %lld escenas gratis de hoy. Sigue con Malmun Pro."
                }
              }
