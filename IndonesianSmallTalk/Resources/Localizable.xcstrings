    "긍정/부정 응답은 연습 점수와 코칭에 반영돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive and negative replies count toward your practice score and coaching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas positivas y negativas cuentan para la puntuación y los consejos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban positif/negatif memengaruhi skor latihan dan saran pelatih."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポジティブ/ネガティブな返事は練習のスコアとコーチングに反映されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积极/消极回应会计入练习得分和指导。"
          }
        }
      }
    },
    "긍정/부정 표현은 연습 시 점수와 코칭에 반영돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive and negative phrases count toward your score and coaching when you practice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las frases positivas y negativas cuentan para la puntuación y los consejos al practicar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa positif/negatif memengaruhi skor latihan dan saran pelatih."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポジティブ/ネガティブな表現は練習時のスコアとコーチングに反映されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积极/消极表达会在练习时计入得分和指导。"
          }
        }
      }
    },
