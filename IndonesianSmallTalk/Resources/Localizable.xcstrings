    "한 글자씩 입력하면서 뇌가 그 표현을 '내 것'으로 만들어요. 천천히 적으셔도 괜찮습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když frázi píšete písmeno po písmenu, mozek si ji osvojí. Klidně pište pomalu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du skriver det bogstav for bogstav, gør hjernen udtrykket til dit eget. Det er helt fint at tage sig tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Buchstabe für Buchstabe tippst, macht dein Gehirn den Ausdruck zu deinem eigenen. Du darfst dir ruhig Zeit lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν το γράφεις γράμμα γράμμα, ο εγκέφαλός σου κάνει την έκφραση δική σου. Δεν πειράζει αν γράφεις αργά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typing it letter by letter makes the expression yours. It's okay to take your time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typing it letter by letter makes the expression yours. It's okay to take your time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al escribir letra por letra, tu cerebro hace «tuya» la frase. No pasa nada si escribes despacio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kirjoitat ilmauksen kirjain kerrallaan, siitä tulee omasi. Voit rauhassa kirjoittaa hitaasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En le tapant lettre après lettre, vous vous appropriez l’expression. Prenez votre temps, ce n’est pas grave."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat mengetik huruf demi huruf, otak menjadikan ungkapan itu \"milik sendiri\". Pelan-pelan saja tidak apa-apa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivendo lettera per lettera, il cervello fa sua l'espressione. Va bene prendersi il proprio tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一文字ずつ入力しながら、脳はその表現を「自分のもの」にします。ゆっくり書いても大丈夫です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du skriver det bokstav for bokstav, blir uttrykket ditt eget. Det går fint å ta det rolig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door het letter voor letter te typen, maak je de uitdrukking de jouwe. Neem gerust de tijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisywanie litera po literze sprawia, że wyrażenie staje się Twoje. Spokojnie, możesz pisać wolno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitar letra por letra faz a expressão ficar sua. Não tem problema ir devagar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы вводите фразу по буквам, мозг делает её своей. Спешить не нужно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genom att skriva det bokstav för bokstav gör du uttrycket till ditt. Det är okej att ta det lugnt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การพิมพ์ทีละตัวอักษรทำให้สมองจดจำสำนวนนั้นเป็นของเรา ค่อย ๆ พิมพ์ช้า ๆ ก็ไม่เป็นไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harf harf yazarken beynin o ifadeyi kendi yapar. Yavaş yazman sorun değil."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi gõ từng chữ, não bạn biến cách diễn đạt đó thành của mình. Cứ thong thả gõ cũng không sao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个字一个字地输入时，大脑会把这个表达变成“自己的”。慢慢写也没关系。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個字一個字打出來，大腦就會把這個表達變成「自己的」。慢慢寫也沒關係。"
          }
        }
      }
    },
