    "직접 입력한 만큼 본인 머리에 남아요. 짧아도, 어색해도 일단 적고 시작하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you type yourself is what stays in your head. Even if it's short or awkward, write it down and get started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que escribes tú se te queda. Aunque sea corto o suene raro, escríbelo y empieza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang diketik sendiri akan membekas di kepala. Pendek atau canggung tak apa, tulis saja dan mulai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で入力した分だけ頭に残ります。短くても、ぎこちなくても、まずは書いて始めましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亲手输入多少，脑子里就留下多少。哪怕很短、很别扭，也先写下来再说。"
          }
        }
      }
    },
    "직접 적는 그 순간이 학습입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moment you write it is when you learn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribirlo tú es aprender"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat menulis sendiri, saat itulah belajar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で書くその瞬間が学習です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亲手写下的那一刻就是学习"
          }
        }
      }
    },
