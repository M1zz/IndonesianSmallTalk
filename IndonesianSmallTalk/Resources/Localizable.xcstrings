    "공유 → \"페이지 소스 복사\" 또는 텍스트 전체 선택 복사": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share → \"Copy page source\", or select all the text and copy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir → «Copiar código fuente» o selecciona todo el texto y cópialo"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan → \"Salin Sumber Halaman\" atau pilih semua teks lalu salin"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有 →「ページのソースをコピー」またはテキストをすべて選択してコピー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享 → “拷贝页面源代码”，或全选文本后拷贝"
          }
        }
      }
    },
    "공유 끊기": {
      "localizations": {
