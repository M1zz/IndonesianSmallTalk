        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่าครั้งเดียว แค่เชื่อมต่อโทรศัพท์กับรถก็เริ่มฝึกได้เลย จากนั้นควบคุมด้วยเสียง"
