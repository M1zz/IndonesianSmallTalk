    "딩 소리가 나면 문장을 말해 보세요. 맞으면 \"좋아요\" 라고 알려 줘요. 그때 이렇게 말해도 돼요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich den Satz nach dem Signalton. Wenn er stimmt, hörst du „Super!“. Du kannst auch sagen:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you hear the chime, say the sentence. If you get it right, you'll hear \"Nice!\" You can also say:"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you hear the chime, say the sentence. If you get it right, you'll hear \"Nice!\" You can also say:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando suene el aviso, di la frase. Si aciertas, oirás «¡Muy bien!». También puedes decir:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous entendez le signal, dites la phrase. Si c’est juste, vous entendrez « Bien ! ». Vous pouvez aussi dire :"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat terdengar bunyi, ucapkan kalimatnya. Kalau benar, kamu akan mendengar \"Bagus!\" Kamu juga bisa bilang:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャイムが鳴ったら文を言ってみましょう。合っていれば「いいね！」と教えてくれます。そのとき、こう言うこともできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ouvir o sinal, diga a frase. Se acertar, você ouvirá \"Boa!\". Você também pode dizer:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда прозвучит сигнал, произнесите фразу. Если всё верно, вы услышите «Отлично!» Ещё можно сказать:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "听到提示音后说出句子。说对了会听到“很好！”。这时也可以说："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聽到提示音後，請說出這個句子。說對了會聽到「很棒！」。你也可以這樣說："
          }
        }
      }
    },
    "따라 말하기" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachsprechen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat after me"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat after me"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repetir en voz alta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répéter après moi"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirukan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復唱"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repita depois de mim"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторяйте за диктором"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟读"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟著說"
          }
        }
      }
    },
    "따라 말하면 점수를 알려 주고, 대화 전체를 메신저처럼 읽고 들을 수 있어요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich dem Audio nach und erhalte eine Bewertung. Ganze Dialoge kannst du wie einen Chat lesen und anhören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat after the audio to get a score, and read or listen to a whole dialogue like a chat."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat after the audio to get a score, and read or listen to a whole dialogue like a chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite y recibe una puntuación, y lee o escucha el diálogo completo como un chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répétez après l’audio pour obtenir un score, et lisez ou écoutez un dialogue entier comme dans une messagerie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirukan untuk dapat skor, dan baca atau dengarkan seluruh dialog seperti chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まねして話すと点数がわかり、会話全体をメッセンジャーのように読んで聞けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repita depois do áudio para receber uma nota e leia ou ouça um diálogo inteiro como num chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторяйте за записью — и получайте оценку, а весь диалог читайте и слушайте как переписку в мессенджере."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟读就能看到分数，还能像聊天一样阅读、收听整段对话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟著音檔說就能得到分數，還能像聊天一樣閱讀、收聽整段對話。"
          }
        }
      }
    },
