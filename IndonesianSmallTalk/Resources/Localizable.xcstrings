    "운전 중에는 화면을 만지지 마세요. 운전대의 다음·이전·재생 버튼도 쓸 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při řízení se nedotýkejte displeje. Můžete použít i tlačítka další, předchozí a přehrát na volantu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rør ikke ved skærmen, mens du kører. Du kan også bruge knapperne til næste, forrige og afspil på rattet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fass beim Fahren den Bildschirm nicht an. Du kannst auch die Tasten für Weiter, Zurück und Wiedergabe am Lenkrad benutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μην αγγίζεις την οθόνη την ώρα που οδηγείς. Μπορείς να χρησιμοποιήσεις και τα κουμπιά επόμενο, προηγούμενο και αναπαραγωγή στο τιμόνι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't touch the screen while driving. You can also use the next, previous and play buttons on your steering wheel."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't touch the screen while driving. You can also use the next, previous and play buttons on your steering wheel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No toques la pantalla mientras manejas. También puedes usar los botones de siguiente, anterior y reproducir del volante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä koske näyttöön ajaessasi. Voit käyttää myös ohjauspyörän seuraava-, edellinen- ja toistopainikkeita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne touchez pas à l’écran en conduisant. Vous pouvez aussi utiliser les boutons suivant, précédent et lecture du volant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan sentuh layar saat menyetir. Kamu juga bisa pakai tombol berikutnya, sebelumnya, dan putar di setir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non toccare lo schermo mentre guidi. Puoi usare anche i pulsanti avanti, indietro e riproduci del volante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運転中は画面に触れないでください。ハンドルの次へ・前へ・再生ボタンも使えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke rør skjermen mens du kjører. Du kan også bruke neste-, forrige- og avspillingsknappene på rattet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raak het scherm niet aan terwijl je rijdt. Je kunt ook de knoppen Volgende, Vorige en Afspelen op je stuur gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie dotykaj ekranu podczas jazdy. Możesz też używać przycisków „następny”, „poprzedni” i „odtwarzaj” na kierownicy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não toque na tela enquanto dirige. Você também pode usar os botões de próxima, anterior e reproduzir do volante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За рулём не трогайте экран. Можно также пользоваться кнопками «следующий», «предыдущий» и «воспроизведение» на руле."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rör inte skärmen medan du kör. Du kan också använda knapparna för nästa, föregående och spela på ratten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อย่าแตะหน้าจอขณะขับรถ ใช้ปุ่มถัดไป ย้อนกลับ และเล่นบนพวงมาลัยได้เช่นกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araba kullanırken ekrana dokunma. Direksiyondaki sonraki, önceki ve oynat düğmelerini de kullanabilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đừng chạm vào màn hình khi đang lái xe. Bạn cũng có thể dùng nút tiếp, trước và phát trên vô lăng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驾驶时请不要触摸屏幕。也可以使用方向盘上的下一首、上一首和播放按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開車時請不要碰螢幕。也可以使用方向盤上的下一首、上一首和播放按鈕。"
          }
        }
      }
    },
