    "초록 = 배운 장면, 회색 = 아직. 칸을 누르면 그 시간의 장면을 연습해요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelená = naučeno, šedá = zatím ne. Klepnutím na políčko procvičíte scény z dané doby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grøn = lært scene, grå = ikke endnu. Tryk på en celle for at øve scenerne i det tidsrum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grün = gelernt, grau = noch nicht. Tippe auf ein Feld, um die Szenen dieser Zeit zu üben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πράσινο = έχεις μάθει τη σκηνή, γκρι = όχι ακόμα. Πάτα ένα κελί για να εξασκηθείς στις σκηνές εκείνης της ώρας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Green = learned, gray = not yet. Tap a cell to practice its scenes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Green = learned, grey = not yet. Tap a cell to practise its scenes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde = aprendida, gris = pendiente. Toca una casilla para practicar sus escenas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vihreä = opittu kohtaus, harmaa = ei vielä. Napauta ruutua harjoitellaksesi sen ajan kohtauksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vert = scène apprise, gris = pas encore. Touchez une case pour pratiquer les scènes de ce moment."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hijau = sudah dipelajari, abu-abu = belum. Ketuk kotak untuk berlatih adegannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde = imparata, grigio = non ancora. Tocca una casella per esercitare le scene di quella fascia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緑 = 学んだシーン、灰色 = まだ。マスをタップするとその時間のシーンを練習できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grønn = lært, grå = ikke ennå. Trykk på en rute for å øve på scenene i det tidsrommet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groen = geleerd, grijs = nog niet. Tik op een vakje om de scènes van dat tijdstip te oefenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zielone = opanowane scenki, szare = jeszcze nie. Dotknij pola, aby ćwiczyć scenki z tej pory."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde = cena aprendida, cinza = ainda não. Toque numa célula para praticar as cenas daquele horário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зелёный — изучено, серый — ещё нет. Нажмите на ячейку, чтобы потренировать сцены этого времени."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grönt = inlärd scen, grått = ännu inte. Tryck på en ruta för att öva dess scener."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขียว = เรียนแล้ว เทา = ยังไม่ได้เรียน แตะช่องเพื่อฝึกฉากในช่วงเวลานั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeşil = öğrenilen sahne, gri = henüz değil. Bir kutuya dokunarak o saatin sahnelerini çalış."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xanh = cảnh đã học, xám = chưa học. Nhấn vào một ô để luyện các cảnh trong khung giờ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绿色 = 已学，灰色 = 未学。点一下格子就能练习那个时段的场景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "綠色 = 已學的場景，灰色 = 還沒學。點一格就能練習那個時段的場景。"
          }
        }
      }
