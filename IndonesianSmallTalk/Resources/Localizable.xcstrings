    "퇴근길에 잘 안 된 문장만 모아서 다음 날 다시 들려줘요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sätze, die dir auf dem Heimweg schwergefallen sind, hörst du am nächsten Tag noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentences you struggled with on your commute come back the next day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentences you struggled with on your commute come back the next day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las frases que te costaron en el trayecto vuelven al día siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les phrases qui vous ont posé problème pendant le trajet reviennent le lendemain."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalimat yang sulit saat perjalanan dikumpulkan dan diputar lagi besoknya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通勤中にうまく言えなかった文だけを集めて、次の日にもう一度流します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As frases em que você teve dificuldade no trajeto voltam no dia seguinte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фразы, которые не получились в дороге, соберутся и прозвучат на следующий день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
