    "홈 우하단 + 버튼 → \"새 스몰토크\". 상황 제목과 첫 마디(배우는 언어 + 뜻) 입력" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startseite ▸ Taste + unten rechts → „Neuer Smalltalk“. Situationstitel und erste Zeile eingeben (in der Lernsprache + Bedeutung)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home ▸ + button at the bottom right → \"New small talk\". Enter a situation title and the opening line (in the language you're learning + meaning)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home ▸ + button at the bottom right → \"New small talk\". Enter a situation title and the opening line (in the language you're learning + meaning)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botón + abajo a la derecha en Inicio → «Nueva charla». Escribe el título de la situación y la primera frase (idioma que aprendes + significado)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accueil ▸ bouton + en bas à droite → « Nouveau small talk ». Saisissez le titre de la situation et la réplique d’ouverture (langue apprise + sens)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol + di kanan bawah beranda → \"Obrolan ringan baru\". Isi judul situasi dan kalimat pembuka (bahasa yang dipelajari + arti)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム右下の + ボタン →「新しいスモールトーク」。場面のタイトルと最初のひとこと(学習中の言語 + 意味)を入力"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Início ▸ botão + no canto inferior direito → \"Novo small talk\". Digite o título da situação e a fala inicial (no idioma que você está aprendendo + significado)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главный экран ▸ кнопка + внизу справа → «Новый small talk». Введите название ситуации и первую реплику (на изучаемом языке + значение)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按主屏幕右下角的 + 按钮 →“新建闲聊”。输入情景标题和开场白（所学语言 + 释义）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首頁右下角的 + 按鈕 →「新增閒聊」。輸入情境標題和開場句（學習語言 + 意思）"
          }
        }
      }
    },
