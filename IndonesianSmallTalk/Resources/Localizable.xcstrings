    "홈 우하단 + 버튼 → \"새 스몰토크\". 상황 제목과 첫 마디(배우는 언어 + 뜻) 입력" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domů ▸ tlačítko + vpravo dole → „Nový small talk“. Zadejte název situace a úvodní větu (v jazyce, který se učíte, + význam)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjem ▸ +-knappen nederst til højre → \"Ny smalltalk\". Skriv en situationstitel og den indledende replik (på det sprog, du lærer + betydning)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startseite ▸ Taste + unten rechts → „Neuer Smalltalk“. Situationstitel und erste Zeile eingeben (in der Lernsprache + Bedeutung)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρχική ▸ κουμπί + κάτω δεξιά → «Νέο small talk». Γράψε τον τίτλο της κατάστασης και την αρχική πρόταση (στη γλώσσα που μαθαίνεις + νόημα)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home ▸ + button at the bottom right → \"New small talk\". Enter a situation title and the opening line (in the language you're learning + meaning)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home ▸ + button at the bottom right → \"New small talk\". Enter a situation title and the opening line (in the language you're learning + meaning)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botón + abajo a la derecha en Inicio → «Nueva charla». Escribe el título de la situación y la primera frase (idioma que aprendes + significado)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etusivu ▸ + -painike oikeassa alakulmassa → ”Uusi small talk”. Kirjoita tilanteen otsikko ja aloitusrepliikki (opiskelemallasi kielellä + merkitys)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accueil ▸ bouton + en bas à droite → « Nouveau small talk ». Saisissez le titre de la situation et la réplique d’ouverture (langue apprise + sens)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol + di kanan bawah beranda → \"Obrolan ringan baru\". Isi judul situasi dan kalimat pembuka (bahasa yang dipelajari + arti)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home ▸ pulsante + in basso a destra → \"Nuova conversazione\". Inserisci il titolo della situazione e la battuta iniziale (nella lingua che stai imparando + significato)"
          }
        },
        "ja" : {
          "stringUnit" : {
