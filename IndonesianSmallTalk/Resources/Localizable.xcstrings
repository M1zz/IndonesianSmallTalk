    "내가 추가/수정/삭제한 슬랭이 모두 사라지고 내장 %lld개로 다시 채워집니다.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "All slang you added, edited, or deleted will be removed and replaced with the %lld built-in term."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "All slang you added, edited, or deleted will be removed and replaced with the %lld built-in terms."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se borrará toda la jerga que añadiste, editaste o eliminaste, y se restaurará %lld entrada integrada."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se borrará toda la jerga que añadiste, editaste o eliminaste, y se restaurarán las %lld entradas integradas."
                }
              }
            }
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua slang yang Anda tambah/ubah/hapus akan hilang dan diganti %lld slang bawaan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加・編集・削除したスラングがすべて消え、内蔵の%lld個に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你添加、编辑、删除的俚语将全部清除，并恢复为内置的 %lld 条。"
          }
        }
      }
    },
    "내가 추가/수정/삭제한 슬랭이 모두 사라집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All slang you added, edited, or deleted will be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrará toda la jerga que añadiste, editaste o eliminaste."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua slang yang Anda tambah/ubah/hapus akan hilang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加・編集・削除したスラングがすべて消えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你添加、编辑、删除的俚语将全部清除。"
          }
        }
      }
    },
    "내비게이션 안내가 나오면 잠깐 멈췄다가 이어서 들려줘요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauses when navigation directions play, then picks up again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hable el navegador, se pausa un momento y luego continúa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ada panduan navigasi, audio dijeda sebentar lalu dilanjutkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビの案内が流れると一時停止し、終わると続きを再生します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导航播报时会暂停，播报结束后继续播放。"
          }
        }
      }
    },
