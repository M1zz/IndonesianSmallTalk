            "state": "translated",
            "value": "Cada escena es una conversación independiente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap adegan adalah percakapan yang berdiri sendiri."
          }
        },
        "ja": {
