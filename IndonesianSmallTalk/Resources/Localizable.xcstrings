    "직접 입력한 만큼 본인 머리에 남아요. 짧아도, 어색해도 일단 적고 시작하세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du selbst eintippst, bleibt im Kopf. Auch wenn es kurz oder holprig ist: Schreib es auf und leg los."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you type yourself is what stays in your head. Even if it's short or awkward, write it down and get started."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you type yourself is what stays in your head. Even if it's short or awkward, write it down and get started."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que escribes tú se te queda. Aunque sea corto o suene raro, escríbelo y empieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous saisissez vous-même reste en tête. Même court, même maladroit, écrivez-le et lancez-vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang diketik sendiri akan membekas di kepala. Pendek atau canggung tak apa, tulis saja dan mulai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分で入力した分だけ頭に残ります。短くても、ぎこちなくても、まずは書いて始めましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você digita fica na sua cabeça. Mesmo que seja curto ou meio estranho, escreva e comece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что вы вводите сами, то и остаётся в голове. Пусть фраза будет короткой или корявой — запишите и начинайте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "亲手输入多少，脑子里就留下多少。哪怕很短、很别扭，也先写下来再说。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自己輸入的，才會留在腦子裡。再短、再彆扭都沒關係，先寫下來開始吧。"
          }
        }
      }
    },
    "직접 적는 그 순간이 학습입니다" : {
