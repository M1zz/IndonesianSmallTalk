    "초록 = 배운 장면, 회색 = 아직. 칸을 누르면 그 시간의 장면을 연습해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green = learned, gray = not yet. Tap a cell to practice its scenes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde = aprendida, gris = pendiente. Toca una casilla para practicar sus escenas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hijau = sudah dipelajari, abu-abu = belum. Ketuk kotak untuk berlatih adegannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑 = 学んだシーン、灰色 = まだ。マスをタップするとその時間のシーンを練習できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绿色 = 已学，灰色 = 未学。点一下格子就能练习那个时段的场景。"
          }
        }
      }
    },
