          }
        }
      }
    },
    "직접 입력한 만큼 본인 머리에 남아요. 짧아도, 어색해도 일단 적고 시작하세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V hlavě vám zůstane to, co sami napíšete. I když je to krátké nebo neohrabané, napište to a začněte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, du selv skriver, sidder bedre fast i hovedet. Også selv om det er kort eller akavet, så skriv det ned og kom i gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du selbst eintippst, bleibt im Kopf. Auch wenn es kurz oder holprig ist: Schreib es auf und leg los."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ό,τι γράφεις μόνος σου μένει στο μυαλό σου. Ακόμα κι αν είναι σύντομο ή αδέξιο, γράψ' το και ξεκίνα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you type yourself is what stays in your head. Even if it's short or awkward, write it down and get started."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you type yourself is what stays in your head. Even if it's short or awkward, write it down and get started."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que escribes tú se te queda. Aunque sea corto o suene raro, escríbelo y empieza."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minkä kirjoitat itse, sen muistat. Vaikka se olisi lyhyt tai kömpelö, kirjoita se muistiin ja aloita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous saisissez vous-même reste en tête. Même court, même maladroit, écrivez-le et lancez-vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang diketik sendiri akan membekas di kepala. Pendek atau canggung tak apa, tulis saja dan mulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta in testa quello che scrivi tu. Anche se è breve o suona strano, scrivilo e comincia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分で入力した分だけ頭に残ります。短くても、ぎこちなくても、まずは書いて始めましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det du skriver selv, blir sittende i hodet. Selv om det er kort eller klønete: skriv det ned og kom i gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je zelf typt, blijft in je hoofd hangen. Ook als het kort of onhandig is: schrijf het op en begin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co wpiszesz sam, zostaje w głowie. Nawet jeśli krótkie albo niezgrabne, zapisz i zacznij."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você digita fica na sua cabeça. Mesmo que seja curto ou meio estranho, escreva e comece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что вы вводите сами, то и остаётся в голове. Пусть фраза будет короткой или корявой — запишите и начинайте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det du skriver själv är det som fastnar i huvudet. Även om det är kort eller krångligt, skriv ner det och sätt igång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พิมพ์เองเท่าไร ก็ติดหัวเท่านั้น สั้นหรือแปลก ๆ ก็ไม่เป็นไร เขียนลงไปแล้วเริ่มเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendin yazdığın kadar aklında kalır. Kısa da olsa, hatalı da olsa önce yaz ve başla."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự gõ bao nhiêu thì đọng lại trong đầu bấy nhiêu. Dù ngắn hay vụng về, cứ viết ra và bắt đầu đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "亲手输入多少，脑子里就留下多少。哪怕很短、很别扭，也先写下来再说。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
