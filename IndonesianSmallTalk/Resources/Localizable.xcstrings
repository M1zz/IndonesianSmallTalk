        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日のシーン数を気にせず、通勤中ずっと耳で練習できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
