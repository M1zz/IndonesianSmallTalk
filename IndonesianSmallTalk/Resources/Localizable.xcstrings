            "value": "Mostrar significado"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan arti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意味を表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示释义"
          }
        }
      }
    },
    "뜻 숨기기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide meaning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar significado"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan arti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意味を隠す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏释义"
          }
        }
      }
    },
    "뜻을 듣고, 먼저 말해 보고, 정답을 들어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hear the meaning, say it first, then hear the answer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha el significado, dilo tú primero y luego escucha la respuesta"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengar arti, coba ucapkan dulu, lalu dengar jawabannya"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意味を聞いて、先に言ってみて、正解を聞きます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听释义，先自己说，再听答案"
          }
        }
      }
    },
    "뜻을 들려준 뒤 잠깐 기다려 줘요. 소리 내어 말해 본 다음 원어민 발음으로 확인하세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It plays the meaning, then waits a moment. Say it out loud, then check it against a native speaker"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras leer el significado, espera un momento. Dilo en voz alta y compruébalo con la pronunciación nativa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah arti dibacakan, ada jeda sebentar. Ucapkan dengan lantang, lalu cek dengan pelafalan penutur asli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意味を読み上げたあと、少し待ちます。声に出して言ってから、ネイティブの発音で確認しましょう"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放释义后会稍等片刻。先说出口，再听母语者发音来确认"
          }
        }
      }
    },
    "로마자 등으로 발음을 적어두면 학습에 도움이 돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noting the pronunciation, for example in romanization, helps you learn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anotar la pronunciación, por ejemplo en letras latinas, te ayuda a aprender."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menulis pelafalan dengan huruf Latin dan sejenisnya membantu belajar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローマ字などで発音を書いておくと学習に役立ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用罗马字等标注发音有助于学习。"
          }
        }
      }
    },
