    "앞 장면에서 배운 표현을 알아야 풀리는 구조가 아닙니다. 어디를 열어도 첫 마디부터 시작해요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst keine Ausdrücke aus früheren Szenen kennen, um mitzukommen. Egal, wo du einsteigst: Es beginnt mit der ersten Zeile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't need phrases from earlier scenes to follow along. Wherever you open, it starts from the first line."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't need phrases from earlier scenes to follow along. Wherever you open, it starts from the first line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necesitas saber las frases de escenas anteriores. Abras la que abras, empiezas desde la primera frase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inutile de connaître les expressions des scènes précédentes pour suivre. Où que vous ouvriez, on repart de la première réplique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak perlu tahu frasa dari adegan sebelumnya. Buka di mana saja, mulai dari kalimat pertama."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前のシーンで学んだ表現を知らないと進めない仕組みではありません。どこを開いても最初のひとことから始まります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não precisa das frases das cenas anteriores para acompanhar. Onde quer que abra, começa pela primeira fala."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы пройти сцену, не нужно знать фразы из предыдущих. Какую бы вы ни открыли, она начинается с первой реплики."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要先学会前面场景的表达。无论打开哪里，都从开场白开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要先學過前面場景的表達才能跟上。不管從哪裡打開，都是從第一句開始。"
          }
        }
      }
    },
