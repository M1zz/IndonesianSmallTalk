          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se sabe quién habla. Empieza con A: o B:."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembicara tidak jelas. Awali dengan A: atau B:."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話者がわかりません。A: または B: で始めてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法判断是谁在说话。请以 A: 或 B: 开头。"
          }
        }
      }
    },
    "누가 먼저 말해요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who speaks first?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quién habla primero?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa yang bicara duluan?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらが先に話しますか?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谁先开口？"
          }
        }
      }
    },
    "누가 어떤 상황에서 한 말이었는지 한 줄로 적어두면 나중에 떠올리기 쉬워요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jot down in one line who said it and where—it'll be easier to remember later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota en una línea quién lo dijo y en qué situación; así lo recordarás mejor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis satu baris tentang siapa yang mengatakannya dan dalam situasi apa agar mudah diingat nanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰がどんな場面で言ったのかを一行で書いておくと、あとで思い出しやすくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用一句话记下是谁在什么场合说的，以后更容易想起来。"
          }
        }
      }
    },
