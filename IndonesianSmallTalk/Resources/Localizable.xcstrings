        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mie frasi, i miei scenari e il vocabolario sono salvati separatamente per ogni lingua. Puoi cambiare di nuovo quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語ごとにマイフレーズ・マイシナリオ・単語帳が別々に保存されます。いつでも切り替えられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mine uttrykk, mine scenarioer og ordlisten lagres separat for hvert språk. Du kan bytte tilbake når som helst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijn zinnen, mijn scenario's en woordenschat worden per taal apart bewaard. Je kunt altijd terugschakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moje zwroty, moje scenariusze i słownictwo są zapisywane osobno dla każdego języka. Zawsze możesz wrócić do poprzedniego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
