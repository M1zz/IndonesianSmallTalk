    "누가 어떤 상황에서 한 말이었는지 한 줄로 적어두면 나중에 떠올리기 쉬워요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stručně si zapište, kdo to řekl a v jaké situaci – později si to snáz vybavíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv i én linje, hvem der sagde det, og hvor – så er det nemmere at huske senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte in einer Zeile fest, wer das wo gesagt hat – so fällt es dir später leichter, dich zu erinnern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψε σε μία γραμμή ποιος το είπε και πού — θα το θυμάσαι πιο εύκολα αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jot down in one line who said it and where—it'll be easier to remember later."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jot down in one line who said it and where; it'll be easier to remember later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota en una línea quién lo dijo y en qué situación; así lo recordarás mejor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita yhdelle riville, kuka sanoi sen ja missä tilanteessa — muistat sen helpommin myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez en une ligne qui a dit cela et dans quelle situation : ce sera plus facile à retrouver plus tard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis satu baris tentang siapa yang mengatakannya dan dalam situasi apa agar mudah diingat nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annota in una riga chi l'ha detto e dove: sarà più facile ricordarlo dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰がどんな場面で言ったのかを一行で書いておくと、あとで思い出しやすくなります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ned i én linje hvem som sa det og hvor – da er det lettere å huske senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf in één regel op wie het zei en waar. Dan onthoud je het later makkelijker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz jednym zdaniem, kto to powiedział i w jakiej sytuacji — łatwiej będzie to później przypomnieć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote numa linha quem disse e onde — fica mais fácil de lembrar depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите одной строкой, кто это сказал и в какой ситуации — потом будет легче вспомнить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv en rad om vem som sa det och var – då är det lättare att minnas senare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จดสั้น ๆ ไว้สักบรรทัดว่าใครพูดประโยคนี้ในสถานการณ์ไหน ภายหลังจะนึกออกง่ายขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimin nerede söylediğini tek satırla not edersen sonradan hatırlaman kolaylaşır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi lại trong một dòng ai đã nói câu đó và trong tình huống nào — sau này sẽ dễ nhớ hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一句话记下是谁在什么场合说的，以后更容易想起来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
