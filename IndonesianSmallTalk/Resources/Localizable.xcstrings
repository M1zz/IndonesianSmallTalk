            "value": "需要时随时取用"
          }
        }
      }
    },
    "하루 장면 수 제한 없이, 출퇴근 내내 귀로 연습해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No daily scene limit. Practice by ear for your whole commute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin límite diario de escenas. Practica de oído todo el trayecto."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa batas adegan harian. Latihan lewat telinga sepanjang perjalanan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日のシーン数を気にせず、通勤中ずっと耳で練習できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不限每日场景数，通勤路上一直用耳朵练习。"
          }
        }
      }
    },
    "하루 코스": {
