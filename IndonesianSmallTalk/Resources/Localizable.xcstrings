    "단축어 앱 ▸ 자동화 ▸ + ▸ 'CarPlay' (또는 '블루투스' ▸ 내 차) ▸ '연결될 때' ▸ '즉시 실행' ▸ 동작에서 '말문 · 퇴근길 연습 시작' 을 고르세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzbefehle ▸ Automation ▸ + ▸ „CarPlay“ (oder „Bluetooth“ ▸ dein Auto) ▸ „Verbunden“ ▸ „Sofort ausführen“ ▸ dann die Aktion „Malmun · Feierabend-Übung starten“ wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcuts ▸ Automation ▸ + ▸ 'CarPlay' (or 'Bluetooth' ▸ your car) ▸ 'Is Connected' ▸ 'Run Immediately' ▸ then choose the action 'Malmun · Start commute practice'."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcuts ▸ Automation ▸ + ▸ 'CarPlay' (or 'Bluetooth' ▸ your car) ▸ 'Is Connected' ▸ 'Run Immediately' ▸ then choose the action 'Malmun · Start commute practice'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atajos ▸ Automatización ▸ + ▸ «CarPlay» (o «Bluetooth» ▸ tu auto) ▸ «Se conecta» ▸ «Ejecutar de inmediato» ▸ y elige la acción «Malmun · Iniciar práctica del trayecto»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccourcis ▸ Automatisation ▸ + ▸ « CarPlay » (ou « Bluetooth » ▸ votre voiture) ▸ « Est connecté » ▸ « Exécuter immédiatement » ▸ puis choisissez l’action « Malmun · Lancer l’entraînement trajet »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintasan ▸ Otomatisasi ▸ + ▸ 'CarPlay' (atau 'Bluetooth' ▸ mobil kamu) ▸ 'Tersambung' ▸ 'Jalankan Segera' ▸ lalu pilih tindakan 'Malmun · Mulai latihan perjalanan'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカット ▸ オートメーション ▸ + ▸ 「CarPlay」（または「Bluetooth」▸ 自分の車）▸ 「接続したとき」▸ 「すぐに実行」▸ アクションで「Malmun・通勤練習を開始」を選びます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atalhos ▸ Automação ▸ + ▸ 'CarPlay' (ou 'Bluetooth' ▸ seu carro) ▸ 'Conectado' ▸ 'Executar imediatamente' ▸ depois escolha a ação 'Malmun · Iniciar prática do trajeto'."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Команды» ▸ «Автоматизация» ▸ + ▸ «CarPlay» (или «Bluetooth» ▸ ваш автомобиль) ▸ «Подключено» ▸ «Выполнять сразу» ▸ затем выберите действие «Malmun · Начать тренировку в пути»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快捷指令 ▸ 自动化 ▸ + ▸ “CarPlay”（或“蓝牙” ▸ 你的车）▸ “连接时” ▸ “立即运行” ▸ 在操作中选择“Malmun · 开始通勤练习”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「捷徑」App ▸ 自動化 ▸ + ▸「CarPlay」（或「藍牙」▸ 你的車）▸「已連接」▸「立即執行」▸ 在動作中選擇「Malmun · 開始通勤練習」。"
          }
        }
      }
    },
