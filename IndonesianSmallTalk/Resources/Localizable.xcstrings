          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noting the pronunciation, for example in romanization, helps you learn."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noting the pronunciation, for example in romanisation, helps you learn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anotar la pronunciación, por ejemplo en letras latinas, te ayuda a aprender."
