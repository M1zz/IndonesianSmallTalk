    "잘 들리지 않았어요. 조금 더 크게 다시 말해 볼까요?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš dobře to nebylo slyšet. Zkusíte to říct trochu hlasitěji?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det var svært at høre. Prøv at sige det lidt højere?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das war kaum zu hören. Sag es noch einmal etwas lauter?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν σε άκουσα καλά. Θες να το ξαναπείς λίγο πιο δυνατά;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't quite hear that. Try saying it a little louder?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't quite hear that. Try saying it a little louder?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se oyó bien. ¿Lo dices otra vez un poco más alto?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En oikein kuullut. Sanotko vähän kovempaa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n’ai pas bien entendu. Pouvez-vous le redire un peu plus fort ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurang terdengar. Coba ucapkan lagi sedikit lebih keras?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ho sentito bene. Vuoi riprovare a voce un po' più alta?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく聞き取れませんでした。もう少し大きな声でもう一度言ってみましょうか?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hørte det ikke helt. Kan du si det litt høyere?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat kon ik niet goed horen. Wil je het wat luider nog eens zeggen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie było dobrze słychać. Spróbujesz powiedzieć trochę głośniej?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não consegui ouvir direito. Que tal repetir um pouco mais alto?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плохо слышно. Скажите ещё раз, чуть громче?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag hörde inte riktigt. Vill du försöka säga det lite högre?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ได้ยินไม่ค่อยชัด ลองพูดให้ดังขึ้นอีกนิดไหม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pek duyulmadı. Biraz daha yüksek sesle tekrar söyler misin?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy nghe chưa rõ. Bạn thử nói to hơn một chút nhé?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没听清楚。再大声一点说一遍好吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒聽清楚。要不要再大聲一點說一次？"
          }
        }
      }
    },
