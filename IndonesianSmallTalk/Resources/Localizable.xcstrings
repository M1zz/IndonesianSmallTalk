        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ cần thiết lập một lần, lên xe kết nối điện thoại là bắt đầu luyện, sau đó bạn điều khiển bằng giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置一次后，上车连接手机就会自动开始，之后用声音操作即可。"
