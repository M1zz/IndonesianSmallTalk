    "긍정/부정 응답은 연습 점수와 코칭에 반영돼요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozitivní a negativní odpovědi se započítávají do skóre a koučinku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive og negative svar tæller med i din øvelsesscore og coaching."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive und negative Antworten fließen in deine Übungspunkte und das Coaching ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι θετικές και οι αρνητικές απαντήσεις μετράνε στη βαθμολογία και στις συμβουλές της εξάσκησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive and negative replies count toward your practice score and coaching."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive and negative replies count towards your practice score and coaching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas positivas y negativas cuentan para la puntuación y los consejos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myönteiset ja kielteiset vastaukset vaikuttavat harjoituspisteisiin ja valmennukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses positives et négatives comptent dans votre score d’entraînement et vos conseils."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban positif/negatif memengaruhi skor latihan dan saran pelatih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte positive e negative contano per il punteggio e i consigli dell'esercizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポジティブ/ネガティブな返事は練習のスコアとコーチングに反映されます。"
          }
        },
        "nb" : {
