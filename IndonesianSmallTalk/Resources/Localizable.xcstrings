    "앞 장면에서 배운 표현을 알아야 풀리는 구조가 아닙니다. 어디를 열어도 첫 마디부터 시작해요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemusíte znát fráze z předchozích scén. Ať otevřete kteroukoli, začíná se od první věty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behøver ikke kende udtryk fra tidligere scener for at følge med. Uanset hvor du åbner, starter det fra den første replik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst keine Ausdrücke aus früheren Szenen kennen, um mitzukommen. Egal, wo du einsteigst: Es beginnt mit der ersten Zeile."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν χρειάζεται να ξέρεις φράσεις από προηγούμενες σκηνές για να παρακολουθήσεις. Όπου κι αν ανοίξεις, ξεκινά από την πρώτη γραμμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't need phrases from earlier scenes to follow along. Wherever you open, it starts from the first line."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't need phrases from earlier scenes to follow along. Wherever you open, it starts from the first line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necesitas saber las frases de escenas anteriores. Abras la que abras, empiezas desde la primera frase."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiempien kohtausten ilmauksia ei tarvitse osata, jotta pysyt mukana. Mihin tahansa avaatkin, alkaa ensimmäisestä repliikistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inutile de connaître les expressions des scènes précédentes pour suivre. Où que vous ouvriez, on repart de la première réplique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak perlu tahu frasa dari adegan sebelumnya. Buka di mana saja, mulai dari kalimat pertama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non servono le frasi delle scene precedenti per seguire. Ovunque apri, si parte dalla prima battuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前のシーンで学んだ表現を知らないと進めない仕組みではありません。どこを開いても最初のひとことから始まります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger ikke uttrykk fra tidligere scener for å henge med. Uansett hvor du åpner, begynner det med første replikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt geen zinnen uit eerdere scènes nodig om mee te komen. Waar je ook opent, het begint bij de eerste regel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie musisz znać zwrotów z wcześniejszych scenek, żeby się odnaleźć. Gdziekolwiek zaczniesz, startujesz od pierwszej kwestii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não precisa das frases das cenas anteriores para acompanhar. Onde quer que abra, começa pela primeira fala."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы пройти сцену, не нужно знать фразы из предыдущих. Какую бы вы ни открыли, она начинается с первой реплики."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behöver inte kunna fraser från tidigare scener för att hänga med. Var du än öppnar börjar det från första raden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่จำเป็นต้องรู้วลีจากฉากก่อนหน้าถึงจะตามทัน เปิดตรงไหนก็เริ่มจากประโยคแรกเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlamak için önceki sahnelerdeki ifadeleri bilmen gerekmez. Nereyi açarsan aç, ilk satırdan başlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không cần biết các cụm từ ở cảnh trước để theo kịp. Mở ở đâu cũng bắt đầu từ câu đầu tiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要先学会前面场景的表达。无论打开哪里，都从开场白开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要先學過前面場景的表達才能跟上。不管從哪裡打開，都是從第一句開始。"
          }
        }
      }
    },
