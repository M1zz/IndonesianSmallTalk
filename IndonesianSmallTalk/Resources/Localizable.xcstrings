    "누가 말하는지 알 수 없어요. A: 또는 B: 로 시작해 주세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unklar, wer spricht. Beginne jede Zeile mit A: oder B:."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't tell who's speaking. Start each line with A: or B:."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't tell who's speaking. Start each line with A: or B:."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se sabe quién habla. Empieza con A: o B:."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de savoir qui parle. Commencez chaque ligne par A: ou B:."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembicara tidak jelas. Awali dengan A: atau B:."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話者がわかりません。A: または B: で始めてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não dá para saber quem está falando. Comece cada linha com A: ou B:."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не понятно, кто говорит. Начинайте каждую строку с A: или B:."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法判断是谁在说话。请以 A: 或 B: 开头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分辨不出是誰在說話。請以 A: 或 B: 開頭。"
          }
        }
      }
    },
    "누가 먼저 말해요?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer spricht zuerst?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who speaks first?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
