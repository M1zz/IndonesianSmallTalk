          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengar arti, coba ucapkan dulu, lalu dengar jawabannya"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意味を聞いて、先に言ってみて、正解を聞きます"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouça o significado, fale primeiro e depois ouça a resposta"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Услышьте значение, скажите сами, а потом послушайте правильный ответ"
          }
        },
