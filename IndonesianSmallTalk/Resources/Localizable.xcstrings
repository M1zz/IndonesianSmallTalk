          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单词本"
          }
        }
      }
    },
    "단축어 앱 ▸ 자동화 ▸ + ▸ 'CarPlay' (또는 '블루투스' ▸ 내 차) ▸ '연결될 때' ▸ '즉시 실행' ▸ 동작에서 '말문 · 퇴근길 연습 시작' 을 고르세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts ▸ Automation ▸ + ▸ 'CarPlay' (or 'Bluetooth' ▸ your car) ▸ 'Is Connected' ▸ 'Run Immediately' ▸ then choose the action 'Malmun · Start commute practice'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atajos ▸ Automatización ▸ + ▸ «CarPlay» (o «Bluetooth» ▸ tu auto) ▸ «Se conecta» ▸ «Ejecutar de inmediato» ▸ y elige la acción «Malmun · Iniciar práctica del trayecto»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan ▸ Otomatisasi ▸ + ▸ 'CarPlay' (atau 'Bluetooth' ▸ mobil kamu) ▸ 'Tersambung' ▸ 'Jalankan Segera' ▸ lalu pilih tindakan 'Malmun · Mulai latihan perjalanan'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット ▸ オートメーション ▸ + ▸ 「CarPlay」（または「Bluetooth」▸ 自分の車）▸ 「接続したとき」▸ 「すぐに実行」▸ アクションで「Malmun・通勤練習を開始」を選びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷指令 ▸ 自动化 ▸ + ▸ “CarPlay”（或“蓝牙” ▸ 你的车）▸ “连接时” ▸ “立即运行” ▸ 在操作中选择“Malmun · 开始通勤练习”。"
          }
        }
      }
    },
