            "value" : "Aucune limite de scènes par jour. Entraînez-vous à l’oreille pendant tous vos trajets."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa batas adegan harian. Latihan lewat telinga sepanjang perjalanan."
