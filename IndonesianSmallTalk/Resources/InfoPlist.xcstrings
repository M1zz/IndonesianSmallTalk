    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun potřebuje přístup k mikrofonu pro konverzační trénink hlasem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun har brug for adgang til mikrofonen, så du kan øve samtaler med stemmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun braucht Zugriff auf das Mikrofon, damit du Gespräche laut üben kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Malmun χρειάζεται πρόσβαση στο μικρόφωνο για την εξάσκηση φωνητικής συνομιλίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun needs microphone access for voice conversation practice."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun needs microphone access for voice conversation practice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun necesita acceso al micrófono para practicar conversaciones por voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun a besoin d’accéder au micro pour les exercices de conversation à voix haute."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun memerlukan akses mikrofon untuk latihan percakapan dengan suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun ha bisogno del microfono per gli esercizi di conversazione a voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声で会話を練習するために、マイクへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 대화 연습을 위해 마이크 접근이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Malmun precisa acessar o microfone para a prática de conversa por voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun использует микрофон для голосовой разговорной практики."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun ต้องใช้ไมโครโฟนสำหรับฝึกสนทนาด้วยเสียง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun cần quyền truy cập micro để bạn luyện hội thoại bằng giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问麦克风以进行语音对话练习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun 需要使用麥克風，才能進行語音會話練習。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun potřebuje rozpoznávání řeči, aby rozuměl tomu, co říkáte, a ověřil vaši výslovnost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun bruger talegenkendelse til at forstå, hvad du siger, og til at tjekke din udtale."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun nutzt die Spracherkennung, um zu verstehen, was du sagst, und deine Aussprache zu prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Malmun χρειάζεται την αναγνώριση ομιλίας για να καταλαβαίνει τι λες και να ελέγχει την προφορά σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun needs speech recognition to understand what you say and check your pronunciation."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun needs speech recognition to understand what you say and check your pronunciation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun necesita el reconocimiento de voz para entender lo que dices y revisar tu pronunciación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun utilise la reconnaissance vocale pour comprendre ce que vous dites et évaluer votre prononciation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin pengenalan ucapan diperlukan untuk mengenali kalimat yang diucapkan dan memeriksa pelafalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun ha bisogno del riconoscimento vocale per capire cosa dici e controllare la tua pronuncia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話した文を聞き取って発音を確認するために、音声認識の許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말한 문장을 알아듣고 발음을 확인하려면 음성 인식 권한이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Malmun precisa do reconhecimento de fala para entender o que você diz e avaliar sua pronúncia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun использует распознавание речи, чтобы понимать, что вы говорите, и проверять ваше произношение."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun ต้องใช้การรู้จำเสียงพูดเพื่อทำความเข้าใจสิ่งที่คุณพูดและตรวจการออกเสียง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun cần nhận dạng giọng nói để hiểu những gì bạn nói và kiểm tra phát âm của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要语音识别权限，以识别你说的句子并检查发音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malmun 需要使用語音辨識，才能聽懂你說的話並檢查你的發音。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}